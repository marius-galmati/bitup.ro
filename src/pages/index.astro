---
/**
 * Pagina Acasă (docs/brief-site-v3.md § 3 și § 5), în ordinea din brief: hero; problema; serviciile ca straturi
 * (diagrama) + IT administrat; cum lucrăm (4 pași); proiecte alese; echipa; îndemnul final pe bleumarin.
 * Alternanța alb → ceață → alb; o singură secțiune bleumarin („Straturile” doar acolo).
 * Faptele vin din copy.md; textele (în afară de hero) sunt propunerile fazei 2, trecute prin umanizare-ro, de aprobat de Marius.
 * noindex până la lansare (faza 6).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Label from '../components/ui/Label.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Steps from '../components/ui/Steps.astro';
import DiagramaServicii from '../components/ui/DiagramaServicii.astro';
import PlaciStraturi from '../components/ui/PlaciStraturi.astro';
import HeroStack from '../components/home/HeroStack.astro';
import { t, localePath, dynamicPath } from '../i18n';
import { services } from '../lib/services';
import { descrieri } from '../copy/servicii/comun.ro';

const lang = 'ro';
const d = t(lang);
const svc = services(lang);
const formHref = `${localePath('contact', lang)}#formular`;


const pasi = [
  { titlu: 'Proiectăm', text: 'Ne uităm la ce folosește firma azi și la ce o încurcă. Stabilim ce rămâne, ce se schimbă și în ce ordine.' },
  { titlu: 'Securizăm', text: 'Punem întâi fundația: conturile și accesul, protecția stațiilor, backup testat, actualizări automate.' },
  { titlu: 'Automatizăm', text: 'Legăm programele între ele, ca datele să se introducă o singură dată. Unde munca e repetitivă, punem agenți AI.' },
  { titlu: 'Administrăm', text: 'Ținem sistemul în funcțiune, cu aceeași echipă care l-a construit.' },
];

const proiecte = `${localePath('projects', lang)}`;
const produse = [
  {
    titlu: 'BitUp Cloud și Hostero',
    text: 'Cloudul nostru privat, operat de aproximativ 6 ani, cu 99,98 % disponibilitate. Pe el rulează Hostero, platforma publică de găzduire hostero.ro.',
    href: localePath('cloud', lang),
    link: 'Despre BitUp Cloud',
  },
  {
    titlu: 'CyberXscore',
    text: 'Autoevaluarea securității unei firme, pe cyberxscore.ro. Include Încadrarea NIS2, gratuită, în aproximativ 3 minute, și NIS2 Ready, platforma de lucru dintre client și consultant.',
    href: `${proiecte}#cyberxscore`,
    link: 'Vezi proiectul',
  },
  {
    titlu: 'ProQ',
    text: 'Software pentru planificarea calității (APQP) în industria auto, construit integral de BitUp și folosit ca SaaS.',
    href: `${proiecte}#proq`,
    link: 'Vezi proiectul',
  },
  {
    titlu: 'BitUp Helpdesk',
    text: 'Platforma noastră de suport, helpdesk.bitup.ro, cu un agent AI integrat în WhatsApp. [DE CONFIRMAT: ce face agentul concret]',
    href: `${proiecte}#helpdesk`,
    link: 'Vezi proiectul',
  },
];

/** copy.md § Fapte aprobate: Echipa (toți au acceptat să apară cu nume și rol). Fără fotografii până la poza nouă a lui Petre. */
const echipa = [
  { nume: 'Marius Galmati', rol: 'CEO și fondator' },
  { nume: 'Samuel Bota', rol: 'AI și inovație' },
  { nume: 'Petre Radu', rol: 'Red Team, securitate ofensivă' },
  { nume: 'Cristian Boanca', rol: 'Dezvoltare full stack' },
];
---
<BaseLayout lang={lang} title="BitUp Technology" description="BitUp Technology, Cluj-Napoca." routeKey="home" noindex>
  {/* 1. Hero (brief § 3): text la stânga, stiva din hero la dreapta de la 1200 px, sub butoane sub atât (ca pe bitup.ro). */}
  <Section tone="white" class="hero" labelledby="hero-titlu">
    <div class="hero__grid">
      <div class="hero__text">
        <Label>BitUp Technology</Label>
        <h1 id="hero-titlu" class="display hero__h1">Proiectăm, securizăm, automatizăm și administrăm <span class="nowrap">IT-ul</span> companiilor în creștere.</h1>
        <p class="hero__lead">Un singur sistem, cu o singură echipă care răspunde de tot, de la servere și securitate la automatizări și agenți AI.</p>
        <div class="hero__actions">
          <Button href={formHref} block>Scrie-ne problema de IT care te costă cel mai mult</Button>
          <Button href={localePath('services', lang)} variant="tertiary">Vezi serviciile</Button>
        </div>
      </div>
      <HeroStack lang={lang} class="hero__graphic" />
    </div>
  </Section>

  {/* 2. Problema: mai mulți furnizori, niciun responsabil. */}
  <Section tone="fog" labelledby="problema-titlu">
    <div class="split">
      <div class="head">
        <Label>Problema</Label>
        <h2 id="problema-titlu">Mai mulți furnizori de IT, niciun responsabil</h2>
      </div>
      <div class="measure">
        <p>Unul ține serverul, altul licențele Microsoft 365, altul a scris aplicația de gestiune. Securitatea nu e a nimănui.</p>
        <p>Când se oprește ceva, fiecare verifică doar partea lui, iar coordonarea rămâne la tine. O oră pe zi pierdută așa înseamnă aproximativ 20 de ore pe lună.</p>
      </div>
    </div>
  </Section>

  {/* 3. Serviciile ca straturi: diagrama de la 768 px; sub atât, plăcile și lista (textul diagramei ar fi ilizibil). */}
  <Section tone="white" labelledby="servicii-titlu">
    <div class="head head--wide">
      <Label>Servicii</Label>
      <h2 id="servicii-titlu">Un singur sistem, construit pe securitate</h2>
      <p class="measure">Fiecare serviciu e un strat. Jos stă securitatea, pe care se sprijină tot restul. Al șaselea serviciu, IT-ul administrat, ține toate straturile în funcțiune.</p>
    </div>
    <div class="layers">
      <div class="layers__art">
        <DiagramaServicii lang={lang} id="diagrama-acasa" class="layers__diagram" />
        <PlaciStraturi id="placi-acasa" class="layers__plates" />
      </div>
      <ol class="layers__list" role="list">
        {svc.slice(0, 5).map((s, i) => (
          <li class="layer">
            <Icon name={s.icon} class="layer__icon" />
            <div>
              <h3 class="layer__title"><a href={localePath(s.key, lang)}>{s.name}</a>{i === 0 && <span class="layer__tag"> · {d.layers.foundation}</span>}</h3>
              <p class="layer__text">{descrieri[s.key as keyof typeof descrieri]}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="managed">
      <Card title={svc[5].name} icon={svc[5].icon} href={localePath('managedIt', lang)} linkLabel="Vezi serviciul" look="surface">
        <p>{descrieri.managedIt}</p>
      </Card>
      <Button href={localePath('services', lang)} variant="tertiary">Vezi toate serviciile</Button>
    </div>
  </Section>

  {/* 4. Cum lucrăm: o secvență reală, deci pași numerotați. */}
  <Section tone="fog" labelledby="pasi-titlu">
    <div class="head head--wide">
      <Label>Cum lucrăm</Label>
      <h2 id="pasi-titlu">Aceeași echipă, de la proiect până la administrare</h2>
    </div>
    <Steps items={pasi.map((p) => ({ title: p.titlu, text: p.text }))} />
  </Section>

  {/* 5. Proiecte alese: studiul de caz Cosmio (acord scris) și produsele proprii. Fără garanțiile IT-ului administrat. */}
  <Section tone="white" labelledby="proiecte-titlu">
    <div class="head head--wide">
      <Label>Proiecte</Label>
      <h2 id="proiecte-titlu">Ce am construit</h2>
      <p class="measure">Un studiu de caz publicat cu acordul clientului și produsele pe care le-am construit pentru noi.</p>
    </div>
    <div class="projects">
      <Card title="Cosmio" href={dynamicPath('project', lang, 'cosmio')} linkLabel="Citește studiul de caz" class="projects__case">
        <p class="small muted">Studiu de caz</p>
        <p>Platformă de contabilitate automatizată. Din martie 2026 îi găzduim, protejăm și operăm infrastructura de producție, cu backup, replicare într-un al doilea datacenter și teste de recuperare.</p>
      </Card>
      {produse.map((p) => (
        <Card title={p.titlu} href={p.href} linkLabel={p.link}><p>{p.text}</p></Card>
      ))}
    </div>
    <Button href={proiecte} variant="tertiary" class="projects__all">Toate proiectele</Button>
  </Section>

  {/* 6. Echipa: nume și rol (copy.md), fără fotografii deocamdată. */}
  <Section tone="fog" labelledby="echipa-titlu">
    <div class="head head--wide">
      <Label>Echipa</Label>
      <h2 id="echipa-titlu">Cine lucrează la sistemul tău</h2>
    </div>
    <ul class="team" role="list">
      {echipa.map((m) => (
        <li class="member">
          <h3 class="member__name">{m.nume}</h3>
          <p class="member__role">{m.rol}</p>
        </li>
      ))}
    </ul>
    <Button href={localePath('about', lang)} variant="tertiary" class="team__more">Despre noi</Button>
  </Section>

  {/* 7. Îndemnul final (brief § 4, oferta principală). Singura secțiune bleumarin, cu „Straturile”. */}
  <CtaBand
    label="Recomandare gratuită"
    title="Scrie-ne problema de IT care te costă cel mai mult."
    text="În 24 de ore lucrătoare primești o recomandare scrisă: ce am face noi în locul tău, chiar dacă nu lucrăm împreună."
    cta={d.nav.cta}
    href={formHref}
  />
</BaseLayout>

<style>
  /* Hero */
  .hero__grid { display: grid; gap: var(--space-6); align-items: center; }
  .hero__text { display: grid; gap: var(--gap-title-text); justify-items: start; }
  .hero__h1 { max-width: 20ch; }
  .hero__lead { max-width: 60ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); margin-top: var(--space-4); width: 100%; }
  /* Sub 1200 px stiva stă sub butoane, cu loc deasupra pentru eticheta stratului 5 și plăcile depărtate (ca pe bitup.ro). */
  .hero__grid :global(.hero__graphic) { padding-top: var(--space-6); }
  @media (min-width: 1200px) {
    .hero__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
    .hero__grid :global(.hero__graphic) { padding-top: 0; }
  }

  /* Capetele de secțiune: eticheta, titlul, textul. */
  .head { display: grid; gap: var(--gap-title-text); justify-items: start; }
  .head h2 { max-width: 24ch; }
  .head--wide { margin-bottom: var(--space-5); }

  /* Problema: titlul în stânga, textul în dreapta, de la 1024 px. */
  .split { display: grid; gap: var(--space-4); }
  @media (min-width: 1024px) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-6); align-items: start; } }

  /* Serviciile ca straturi */
  .layers { display: grid; gap: var(--space-5); align-items: center; }
  .layers__art :global(.layers__diagram) { display: none; }
  .layers__art :global(.layers__plates) { max-width: calc(var(--space-8) * 3); margin-inline: auto; }
  @media (min-width: 768px) {
    .layers__art :global(.layers__diagram) { display: block; }
    .layers__art :global(.layers__plates) { display: none; }
  }
  @media (min-width: 1024px) { .layers { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-6); } }
  .layers__list { display: grid; }
  .layer { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); padding-block: var(--space-3); border-bottom: var(--border-width) solid var(--color-border); }
  .layer:first-child { border-top: var(--border-width) solid var(--color-border); }
  .layer :global(.layer__icon) { margin-top: var(--space-1); }
  .layer__title { font-size: var(--fs-body); line-height: var(--lh-body); }
  .layer__title a { color: var(--color-heading); text-decoration: none; }
  .layer__title a:hover { color: var(--color-link); text-decoration: underline; }
  .layer__tag { font-weight: var(--fw-regular); color: var(--color-text-muted); }
  .layer__text { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--color-text-muted); margin-top: var(--space-1); }
  .managed { display: grid; gap: var(--space-4); margin-top: var(--space-5); justify-items: start; }
  .managed :global(.card) { width: 100%; }
  /* Aceeași grilă ca diagrama și lista: cardul sub diagramă, linkul spre hub sub listă. */
  @media (min-width: 1024px) { .managed { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-6); align-items: center; } }

  /* Proiecte: studiul de caz pe toată lățimea, produsele câte două (câte patru, rândurile ar avea 6–8 cuvinte). */
  .projects { display: grid; gap: var(--space-4); }
  @media (min-width: 768px) {
    .projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .projects :global(.projects__case) { grid-column: 1 / -1; }
  }
  :global(.projects__all) { margin-top: var(--space-5); }

  /* Echipa: nume și rol, fără fotografii. */
  .team { display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .team { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .member { padding-top: var(--space-3); border-top: var(--border-width) solid var(--color-border); }
  .member__name { font-size: var(--fs-h3); }
  .member__role { margin-top: var(--space-1); color: var(--color-text-muted); }
  :global(.team__more) { margin-top: var(--space-5); }
</style>
