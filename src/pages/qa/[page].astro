---
/**
 * /qa/componente și /qa/tokens — pagini de QA autorizate de Marius (excepție de la regula 4 din CLAUDE.md): doar local,
 * noindex, exclusă din sitemap, absentă în producție (SITE_ENV === 'production' → getStaticPaths returnează []).
 * Fiecare componentă din Faza 1, în toate stările, plus paleta și scara tipografică. Textele sunt din spec/continut (nu inventate).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Steps from '../../components/Steps.astro';
import FactStrip from '../../components/FactStrip.astro';
import NumberTiles from '../../components/NumberTiles.astro';
import Quote from '../../components/Quote.astro';
import CtaBand from '../../components/CtaBand.astro';
import Prose from '../../components/Prose.astro';
import Figure from '../../components/Figure.astro';
import ConsentBanner from '../../components/ConsentBanner.astro';
import QaTokens from '../../components/qa/QaTokens.astro';
import { isProduction } from '../../lib/env';
import { t } from '../../i18n';

export function getStaticPaths() {
  // `tokens` e criteriul de acceptare al pasului R1 (PLAN § Faza R).
  return isProduction ? [] : [{ params: { page: 'componente' } }, { params: { page: 'tokens' } }];
}

const { page } = Astro.params;
const esteTokeni = page === 'tokens';

const dict = t('ro');
const brand = [
  ['--navy', '#00202E'], ['--navy-2', '#003343'], ['--teal', '#20686C'], ['--teal-2', '#4A9396'], ['--teal-soft', '#E3EFEF'], ['--orange', '#FE982A'],
];
const neutrals = ['--bg', '--surface', '--surface-2', '--line', '--text', '--muted', '--ok', '--warn', '--crit', '--navy-surface', '--navy-surface-2'];
const type = [
  ['--fs-hero', 'Hero, Public Sans 600'], ['--fs-h1', 'H1, Public Sans 600'], ['--fs-h2', 'H2, Public Sans 600'], ['--fs-h3', 'H3, Bricolage 600'],
  ['--fs-lead', 'Lead, Public Sans'], ['--fs-body', 'Body, Public Sans 400'], ['--fs-small', 'Small'], ['--fs-eyebrow', 'Eyebrow, Plex Mono'],
];
// Texte din spec/continut/01-acasa.md § 3 (carduri) și § 4 (pași); spec/continut/studii-de-caz/proq.md (facts, numbers); 09-despre (Prose).
const cards = [
  { title: 'Suport și administrare IT', text: 'Preluăm tot ce ține de calculatoare, servere, rețea, cloud și Microsoft 365, în abonament lunar. Echipa ta scrie pe WhatsApp, un om răspunde, iar la sfârșitul lunii primești raportul cu ce s-a făcut.', link: 'Vezi ce include abonamentul', href: '/servicii/suport-it' },
  { title: 'Securitate și continuitate', text: 'Protecție împotriva atacurilor, accese controlate, backup care chiar se restaurează, testat periodic. Când firma ta are obligații (NIS2, ISO 27001), le traducem în pași concreți, nu în hârtii.', link: 'Vezi ce protejăm și cum', href: '/servicii/securitate' },
  { title: 'Automatizări și software', text: 'Când un proces trăiește în Excel și în emailuri, îl mutăm într-un sistem: automatizare, integrare sau o aplicație făcută pentru voi. Pornim de la proces, nu de la tehnologie.', link: 'Vezi exemple reale', href: '/servicii/automatizari' },
];
const steps = [
  { title: 'Radiografie.', text: '30 de minute, remote, gratuit. Zece verificări. Pleci cu o pagină: ce e bine, ce e urgent, ce ar costa.' },
  { title: 'Plan.', text: 'Ce facem în prima lună, ce poate aștepta, ce nu merită făcut deloc. În cuvinte de business, cu prețul lângă.' },
  { title: 'Preluare.', text: 'În primele 30 de zile documentăm tot, schimbăm parolele care trebuie schimbate, punem backup-ul la punct și îl testăm.' },
  { title: 'Lună de lună.', text: 'Monitorizare, suport pe WhatsApp, actualizări, raport lunar. Tu știi ce se întâmplă fără să întrebi.' },
];
const facts = [
  { k: 'Produs', v: 'ProQ · pro-q.ro' },
  { k: 'Rolul BitUp', v: 'Dezvoltare 100%, găzduire, operare, actualizări, suport' },
  { k: 'Clienți', v: 'Furnizori din industria auto din România, Mexic, India și China' },
  { k: 'Model', v: 'SaaS, abonament per utilizator, sau instalat pe serverele clientului' },
];
const heroFacts = [{ v: dict.factStrip.since }, { v: dict.factStrip.city }, { v: dict.factStrip.response }, { v: dict.factStrip.partners.join(' · ') }];
const numbers = [
  { v: '29', k: 'module, grupate pe cele 6 faze APQP, de la planificare la viața de serie' },
  { v: '8', k: 'standarde din industria auto implementate în platformă' },
  { v: '4', unit: 'țări', k: 'România, Mexic, India, China: furnizori auto care rulează ProQ în producție' },
  { v: '2.293', k: 'teste automate care rulează la fiecare actualizare, înainte ca ea să ajungă la clienți' },
];
---
<BaseLayout
  lang="ro"
  title={esteTokeni ? "QA · tokeni · BitUp" : "QA · componente · BitUp"}
  description={esteTokeni ? "Pagină de QA: fonturile, scara de tip și culorile stilului nou, în ambele teme. Doar dev și staging." : "Pagină de QA: toate componentele din Faza 1, în toate stările, în ambele teme. Doar dev și staging."}
  path={esteTokeni ? "/qa/tokens" : "/qa/componente"}
  altPath="/en"
  noindex
  noAlternates
>
  {esteTokeni && <QaTokens />}
  {!esteTokeni && (
  <Fragment>
  <Section tone="surface-2">
    <Container>
      <Eyebrow>QA · doar dev și staging</Eyebrow>
      <h1 class="qa-h1">Componentele din Faza 1, în toate stările</h1>
      <p class="lead">Se verifică în light și dark, la 375, 768, 1024 și 1440 px. Textele sunt din spec, nu inventate.</p>
    </Container>
  </Section>

  <Section tone="bg" id="paleta">
    <Container>
      <Eyebrow>Tokeni</Eyebrow>
      <h2 class="qa-h2">Paleta</h2>
      <ul class="qa-swatches">
        {brand.map(([tok, hex]) => <li><span class="qa-chip" style={`background: var(${tok})`}></span><span class="small">{tok} {hex}</span></li>)}
      </ul>
      <ul class="qa-swatches">
        {neutrals.map((tok) => <li><span class="qa-chip" style={`background: var(${tok})`}></span><span class="small">{tok}</span></li>)}
      </ul>
      <h2 class="qa-h2">Scara tipografică</h2>
      <ul class="qa-type">
        {type.map(([tok, label]) => <li><span class="small muted">{tok} · {label}</span><p class:list={['qa-sample', tok.replace('--fs-', 'qa-')]}>Suport IT și securitate pentru firme din Cluj · ăâîșț</p></li>)}
      </ul>
    </Container>
  </Section>

  <Section tone="surface" line id="butoane">
    <Container>
      <Eyebrow>Butoane</Eyebrow>
      <h2 class="qa-h2">Principal, secundar, terțiar, plin teal; hover, focus, activ, dezactivat</h2>
      <div class="qa-row">
        <Button href="#">Radiografie IT gratuită</Button>
        <Button href="#" variant="secondary">Explorează serviciile</Button>
        <Button href="#" variant="tertiary">Cum decurge o radiografie</Button>
        <Button href="#" variant="teal">Scrie-i lui Cipri pe WhatsApp</Button>
      </div>
      <div class="qa-row">
        <Button href="#" class="qa-hover">principal hover</Button>
        <Button href="#" class="qa-focus">principal focus</Button>
        <Button href="#" class="qa-active">principal activ</Button>
        <Button disabled>principal dezactivat</Button>
      </div>
      <div class="qa-row">
        <Button href="#" variant="secondary" class="qa-hover">secundar hover</Button>
        <Button href="#" variant="secondary" class="qa-focus">secundar focus</Button>
        <Button href="#" variant="secondary" class="qa-active">secundar activ</Button>
        <Button variant="secondary" disabled>secundar dezactivat</Button>
      </div>
      <div class="qa-row">
        <Button href="#" variant="teal" class="qa-hover">teal hover</Button>
        <Button href="#" variant="teal" class="qa-focus">teal focus</Button>
        <Button href="#" variant="tertiary" class="qa-hover">terțiar hover</Button>
        <Button href="#" variant="tertiary" class="qa-focus">terțiar focus</Button>
        <Button href="#" size="small">mic (header)</Button>
      </div>
      <p class="small muted">Stările „hover/focus/activ” de mai sus sunt forțate din CSS pentru captură; cele reale se verifică cu mouse-ul și cu Tab.</p>
    </Container>
  </Section>

  <Section tone="bg" id="card">
    <Container>
      <Eyebrow>Card</Eyebrow>
      <h2 class="qa-h2">Trei carduri, grid asimetric (primele două mai late)</h2>
      <div class="qa-cards">
        {cards.map((c) => <Card title={c.title} href={c.href} linkLabel={c.link}><p>{c.text}</p></Card>)}
      </div>
    </Container>
  </Section>

  <Section tone="surface" line id="steps">
    <Container>
      <Eyebrow>Steps</Eyebrow>
      <h2 class="qa-h2">Patru pași. Al patrulea nu se termină.</h2>
      <Steps steps={steps} />
    </Container>
  </Section>

  <Section tone="bg" id="factstrip">
    <Container>
      <Eyebrow>FactStrip</Eyebrow>
      <h2 class="qa-h2">Cu etichete (studiu de caz) și fără (sub hero)</h2>
      <div class="qa-stack">
        <FactStrip items={facts} />
        <FactStrip items={heroFacts} label="Fapte" />
      </div>
    </Container>
  </Section>

  <Section tone="surface" line id="numbertiles">
    <Container>
      <Eyebrow>NumberTiles</Eyebrow>
      <h2 class="qa-h2">Cifre reale (ProQ)</h2>
      <NumberTiles items={numbers} />
    </Container>
  </Section>

  <Section tone="bg" id="quote">
    <Container>
      <Eyebrow>Quote</Eyebrow>
      <h2 class="qa-h2">Citat cu nume și funcție</h2>
      <Quote name="[[CITAT_COSMIN]]" role="administrator, Cosmio Fintech SRL">[[CITAT_COSMIN]]</Quote>
    </Container>
  </Section>

  <Section tone="surface" line id="figure">
    <Container>
      <Eyebrow>Figure</Eyebrow>
      <h2 class="qa-h2">Captură de ecran cu legendă (bordură, în dark brightness .92)</h2>
      <div class="qa-figure">
        <Figure kind="screenshot" caption="Conversația pe WhatsApp cu Cipri: mesajul „nu mă pot conecta la VPN”, întrebările de clarificare și butoanele de răspuns">
          <img src="/qa/whatsapp-cipri.jpg" alt="Conversația pe WhatsApp cu Cipri" width="777" height="1010" decoding="async" />
        </Figure>
      </div>
    </Container>
  </Section>

  <Section tone="bg" id="prose">
    <Container>
      <div class="qa-two">
        <div class="qa-two__aside"><Eyebrow>Prose</Eyebrow><p class="small muted">Modelul „două coloane”: eyebrow sticky în stânga, text 70ch în dreapta.</p></div>
        <Prose>
          <h2>Din 2017, în IT-ul firmelor mici. Apoi la scară mare. Apoi înapoi, cu ce am învățat.</h2>
          <p>Lucrez în IT din 2017. Am început ca administrator de sistem în firme mici din Cluj, unde făceam de toate: servere, rețea, backup, firewall, utilizatori, telefonul care sună când nu merge imprimanta. Acolo am înțeles că într-o firmă mică IT-ul nu e un departament, e un om. Și când omul acela nu e, nu e nimeni.</p>
          <p>Am trecut apoi printr-o companie de software în creștere, unde am proiectat infrastructura noului sediu și am ținut suportul la nivel de SLA, cu tichete, timpi de răspuns și rapoarte. Iar din 2024 până în 2026 am lucrat la Concentrix, o corporație din Fortune 500, în securitate informațională: audituri ISO 27001 interne și externe, politici și guvernanță, planuri de continuitate și recuperare, protecție pe stații și servere, Microsoft 365 și Active Directory. La scara aceea, o greșeală se vede imediat.</p>
          <h3>Traseul</h3>
          <ul>
            <li><strong>2010–2014</strong> · Calculatoare, Universitatea Tehnică din Cluj-Napoca</li>
            <li><strong>2017–2021</strong> · Administrator de sistem într-o firmă din Cluj: virtualizare, Active Directory, firewall Fortinet, backup și recuperare cu Veeam</li>
            <li><strong>2020</strong> · Pornesc BitUp Technology</li>
          </ul>
          <p>BitUp l-am pornit în 2020, din ce vedeam la firmele mici: aveau tehnologie, dar nu aveau structură; aveau furnizori, dar nu aveau un partener; aveau inițiative de digitalizare, dar nimeni nu-și asuma imaginea de ansamblu. Iar securitatea era mereu „extra”, ceva ce se adaugă după, dacă mai rămân bani. Am construit BitUp ca să fie invers: un singur partener care răspunde de tot IT-ul, cu securitatea făcută de la început, nu vândută separat. → <a href="/despre">Povestea, pe scurt</a></p>
        </Prose>
      </div>
    </Container>
  </Section>

  <Section tone="surface" line id="banner">
    <Container>
      <Eyebrow>ConsentBanner</Eyebrow>
      <h2 class="qa-h2">Bannerul de consimțământ (aici randat în flux, nu fix)</h2>
      <div class="qa-banner"><ConsentBanner lang="ro" visible current="declined" /></div>
    </Container>
  </Section>

  <CtaBand lang="ro" />
  </Fragment>
  )}
</BaseLayout>

<style>
  .qa-h1 { margin-top: var(--s-3); }
  .qa-h2 { margin-top: var(--s-3); margin-bottom: var(--s-5); }
  .qa-swatches { list-style: none; padding: 0; margin: 0 0 var(--s-5); display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .qa-swatches li { display: grid; gap: var(--s-1); }
  .qa-chip { display: block; height: var(--s-7); border: 1px solid var(--line); border-radius: var(--r-media); }
  .qa-type { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-4); }
  .qa-sample { font-family: var(--font-display); font-weight: 700; color: var(--navy); line-height: 1.15; }
  .qa-hero { font-size: var(--fs-hero); } .qa-h1.qa-sample { font-size: var(--fs-h1); } .qa-h2.qa-sample { font-size: var(--fs-h2); margin: 0; } .qa-h3 { font-size: var(--fs-h3); font-weight: 600; }
  .qa-lead { font-family: var(--font-body); font-weight: 400; font-size: var(--fs-lead); color: var(--muted); }
  .qa-body { font-family: var(--font-body); font-weight: 400; font-size: var(--fs-body); color: var(--text); }
  .qa-small { font-family: var(--font-body); font-weight: 400; font-size: var(--fs-small); color: var(--muted); }
  .qa-eyebrow { font-family: var(--font-display); font-weight: 300; font-size: var(--fs-eyebrow); text-transform: uppercase; color: var(--navy); }
  .qa-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); margin-bottom: var(--s-4); }
  .qa-cards { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  @media (min-width: 1024px) { .qa-cards { grid-template-columns: 1.15fr 1.15fr 1fr; } }
  .qa-stack { display: grid; gap: var(--s-5); }
  .qa-figure { max-width: 420px; }
  .qa-two { display: grid; gap: var(--s-5); }
  @media (min-width: 1024px) { .qa-two { grid-template-columns: 240px 1fr; gap: var(--s-7); } .qa-two__aside { position: sticky; top: calc(64px + var(--s-5)); align-self: start; display: grid; gap: var(--s-3); } }
  .qa-banner :global(.consent) { position: static; width: auto; max-width: 420px; }

  /* Stări forțate pentru captură */
  :global(.qa-hover.btn--primary) { background: #E9891F; border-color: #E9891F; }
  :global(.qa-active.btn--primary) { background: #D97C17; border-color: #D97C17; }
  :global(.qa-focus.btn--primary) { outline: 2px solid #00202E; outline-offset: 2px; }
  :global(.qa-hover.btn--secondary) { background: var(--teal-soft); }
  :global(.qa-active.btn--secondary) { border-color: var(--navy); color: var(--navy); }
  :global(.qa-focus.btn--secondary), :global(.qa-focus.btn--teal), :global(.qa-focus.btn--tertiary) { outline: 2px solid var(--teal); outline-offset: 2px; }
  :global(.qa-hover.btn--teal) { background: var(--navy-2); border-color: var(--navy-2); }
  :global(.qa-hover.btn--tertiary) { color: var(--navy); }
</style>
