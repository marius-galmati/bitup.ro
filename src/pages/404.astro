---
/**
 * 404 (ARHITECTURA § Limbi, 00-global § Pagina 404, ambele limbi): o singură pagină, bilingvă compact.
 * Textul român sus, cel englez sub o linie, cu lang="en". Comutatorul de limbă duce la / și /en. Status 404 real: nginx servește 404.html (deploy/nginx/default.conf, error_page).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import { t, localePath, routes, type RouteKey } from '../i18n';
import { site } from '../lib/site';

const ro = t('ro').notFound;
const en = t('en').notFound;
const title = `${ro.title} · ${site.name}`;
---
<BaseLayout lang="ro" title={title} description={ro.text} path="/404" altPath={routes.home.en} noindex noAlternates>
  <Section tone="bg">
    <Container narrow>
      <div class="nf">
        <h1>{ro.h1}</h1>
        <p class="lead">{ro.text}</p>
        <ul class="nf__links">
          {ro.links.map((l) => <li><a href={localePath(l.route as RouteKey, 'ro')}>{l.label}</a></li>)}
        </ul>
        <p class="small muted">{ro.under}</p>
      </div>

      <hr class="nf__rule" />

      <div class="nf" lang="en">
        <h2 class="nf__h2">{en.h1}</h2>
        <p class="lead">{en.text}</p>
        <ul class="nf__links">
          {en.links.map((l) => <li><a href={localePath(l.route as RouteKey, 'en')} hreflang="en">{l.label}</a></li>)}
        </ul>
        <p class="small muted">{en.under}</p>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .nf { display: grid; gap: var(--s-4); }
  .nf__h2 { font-size: var(--fs-h1); }
  .nf__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .nf__links a { font-family: var(--font-display); font-weight: 600; }
  .nf__rule { border: 0; border-top: 1px solid var(--line); margin-block: var(--s-7); }
</style>
