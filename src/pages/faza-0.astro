---
// Pagină TEMPORARĂ pentru acceptarea Fazei 0: cele trei fonturi și culorile de brand, în light și dark.
// Se șterge în Faza 1, când apar BaseLayout și 404.
// Fonturi self-hosted (ARHITECTURA § Stack): doar axa wght, subseturile latin + latin-ext, font-display: swap.
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/tokens.css';
import '../styles/base.css';

const brand = [
  { token: '--navy', hex: '#00202E', role: 'titluri, fundaluri închise' },
  { token: '--teal', hex: '#20686C', role: 'acțiune, linkuri, accente' },
  { token: '--teal-2', hex: '#4A9396', role: 'accente secundare' },
  { token: '--orange', hex: '#FE982A', role: 'doar butonul de Radiografie' },
];
const neutrals = ['--bg', '--surface', '--surface-2', '--line', '--text', '--muted', '--teal-soft'];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Faza 0 · fonturi și tokeni · BitUp</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('bitup-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="container">
      <p class="eyebrow">Faza 0 · pagină temporară</p>
      <h1>Bricolage Grotesque 700: IT-ul firmei tale, administrat de cineva care răspunde de el.</h1>
      <h2>Bricolage Grotesque 700, h2: Trei lucruri, făcute până la capăt</h2>
      <h3>Bricolage Grotesque 600, h3: Securitate și continuitate · Ăă Ââ Îî Șș Țț</h3>
      <p class="lead">Source Sans 3, lead 20 px: Suport și administrare IT pentru firme de 10–100 de angajați. Un singur partener, un singur număr de telefon.</p>
      <p>Source Sans 3 400, body 17 px / 1.6: Preluăm tot ce ține de calculatoare, servere, rețea, cloud și Microsoft 365, în abonament lunar. Echipa ta scrie pe WhatsApp, un om răspunde, iar la sfârșitul lunii primești raportul cu ce s-a făcut. <strong>Source Sans 3 600 pentru accent.</strong> Diacritice: ăâîșț ĂÂÎȘȚ. Ghilimele: „…” «…».</p>
      <p class="mono">IBM Plex Mono 400: +40 757 150 894 · office@bitup.ro · 0123456789</p>
      <p class="mono w500">IBM Plex Mono 500: Din 2020 · Cluj-Napoca · Răspuns sub 2 ore în program</p>
      <p class="small muted">--muted, --fs-small: text secundar, legende. <a href="#">Un link</a> subliniat cu offset.</p>

      <h2 class="section">Culorile de brand</h2>
      <ul class="swatches">
        {brand.map((c) => (
          <li>
            <span class="chip" style={`background: var(${c.token})`}></span>
            <span class="mono small">{c.token} {c.hex}</span>
            <span class="small muted">{c.role}</span>
          </li>
        ))}
      </ul>

      <h2 class="section">Neutre (se schimbă cu tema)</h2>
      <ul class="swatches">
        {neutrals.map((token) => (
          <li>
            <span class="chip" style={`background: var(${token})`}></span>
            <span class="mono small">{token}</span>
          </li>
        ))}
      </ul>

      <h2 class="section">Suprafață navy</h2>
      <div class="navy">
        <p class="eyebrow on-navy-eyebrow">Eyebrow teal-2 pe navy</p>
        <h3 class="on-navy">Bloc pe --navy-surface, text --on-navy</h3>
        <p class="on-navy-muted">Text secundar în --on-navy-muted. Butonul orange rămâne identic în ambele teme:</p>
        <a class="btn-primary" href="#">Radiografie IT gratuită</a>
      </div>
    </main>
  </body>
</html>

<style>
  main { padding-block: var(--s-8); display: grid; gap: var(--s-5); }
  .section { margin-top: var(--s-6); }
  .w500 { font-weight: 500; }
  .swatches { list-style: none; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .swatches li { display: grid; gap: var(--s-2); }
  .chip { display: block; height: var(--s-8); border: 1px solid var(--line); border-radius: var(--radius); }
  .navy { background: var(--navy-surface); color: var(--on-navy); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--s-6); display: grid; gap: var(--s-4); }
  .on-navy { color: var(--on-navy); }
  .on-navy-muted { color: var(--on-navy-muted); }
  .on-navy-eyebrow { color: var(--teal-2); }
  .btn-primary {
    justify-self: start;
    background: var(--orange); color: #00202E;
    font-family: var(--font-display); font-weight: 700; font-size: var(--fs-body);
    text-decoration: none; padding: 14px 22px; border-radius: var(--radius);
    transition: background-color 150ms;
  }
  .btn-primary:focus-visible { outline: 2px solid #00202E; outline-offset: 2px; }
</style>
