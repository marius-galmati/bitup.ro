---
/** /en/results/[slug]: case studies in English; drafts get a page only outside production (CF_PAGES_BRANCH ≠ main). */
import { render } from 'astro:content';
import CaseLayout from '../../../layouts/CaseLayout.astro';
import { visibleCases, slugOf } from '../../../lib/collections';

export async function getStaticPaths() {
  return (await visibleCases('en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<CaseLayout lang="en" entry={entry}><Content /></CaseLayout>
