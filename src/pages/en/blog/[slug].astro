---
/** /en/blog/[slug]: articles in English (translated slug from the EN frontmatter); drafts only outside production. */
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { visiblePosts, slugOf } from '../../../lib/collections';

export async function getStaticPaths() {
  return (await visiblePosts('en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<PostLayout lang="en" entry={entry}><Content /></PostLayout>
