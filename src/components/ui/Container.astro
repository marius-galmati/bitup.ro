---
/** Container (componente.md § Secțiuni): maximum 1200 px, cu marginile din --gutter. `narrow` = lățimea textului lung (68 de caractere). */
interface Props { narrow?: boolean; class?: string }
const { narrow = false, class: className } = Astro.props;
---
<div class:list={['container', narrow && 'container--narrow', className]}><slot /></div>

<style>
  .container { width: 100%; max-width: calc(var(--container) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }
  .container--narrow { max-width: calc(var(--measure) + 2 * var(--gutter)); }
</style>
