---
/**
 * Banda de îndemn final: secțiunea bleumarin a paginii (una singură), cu elementul „Straturile” pornit din marginea de jos.
 * Butonul principal e portocaliu cu text bleumarin (rolurile din `.on-navy`). Textul vine din pagină, prin props.
 */
import Section from './Section.astro';
import Label from './Label.astro';
import Button from './Button.astro';
import Straturile from './Straturile.astro';
interface Props { label?: string; title: string; text?: string; cta: string; href: string; id?: string }
const { label, title, text, cta, href, id = 'indemn' } = Astro.props;
---
<Section tone="navy" class="cta" labelledby={`${id}-titlu`}>
  <div class="cta__inner">
    {label && <Label>{label}</Label>}
    <h2 id={`${id}-titlu`} class="cta__title">{title}</h2>
    {text && <p class="cta__text">{text}</p>}
    <div class="cta__actions"><Button href={href} block>{cta}</Button><slot /></div>
  </div>
  <Straturile format="banda" />
</Section>

<style>
  :global(.cta.section) { padding-bottom: calc(var(--section-y) + min(18vw, calc(var(--space-8) * 2.5))); }
  .cta__inner { position: relative; z-index: 1; display: grid; gap: var(--gap-title-text); max-width: var(--measure); }
  .cta__title { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--ls-h1); }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); margin-top: var(--space-3); }
</style>
