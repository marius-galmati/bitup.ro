---
/**
 * Întrebări frecvente: `<details>` nativ (merge din tastatură și fără JavaScript). Rânduri cu linie de jos 1 px,
 * întrebarea în 600, semnul plus de linie se rotește în „×” când răspunsul e deschis. Fără pastile rotunjite.
 * Aceleași perechi dau `FAQPage` în JSON-LD (faza 3).
 */
import Icon from './Icon.astro';
interface Item { q: string; a: string }
interface Props { items: Item[]; open?: number; class?: string }
const { items, open, class: className } = Astro.props;
---
<div class:list={['faq', className]}>
  {items.map((it, i) => (
    <details class="faq__item" open={open === i}>
      <summary class="faq__q"><span>{it.q}</span><Icon name="plus" class="faq__icon" /></summary>
      <div class="faq__a"><p>{it.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: var(--border-width) solid var(--color-border); }
  .faq__item { border-bottom: var(--border-width) solid var(--color-border); }
  .faq__q {
    display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);
    padding: var(--space-4) 0; cursor: pointer; list-style: none;
    font-weight: var(--fw-semibold); color: var(--color-heading); font-size: var(--fs-body); line-height: var(--lh-small);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover span { text-decoration: underline; text-decoration-thickness: var(--border-width); text-underline-offset: 0.25em; }
  .faq__q :global(.faq__icon) { margin-top: 1px; transition: transform var(--dur); }
  .faq__item[open] .faq__q :global(.faq__icon) { transform: rotate(45deg); }
  .faq__a { padding: 0 0 var(--space-4); max-width: var(--measure); }
</style>
