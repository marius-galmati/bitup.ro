---
/**
 * Breadcrumb: traseul vizibil, 14 px, linkuri teal; ultima poziție e pagina curentă (aria-current).
 * Datele pentru `BreadcrumbList` (JSON-LD) se construiesc din aceleași elemente, în faza 6.
 */
import Icon from './Icon.astro';
import { t, type Locale } from '../../i18n';
interface Crumb { label: string; href?: string }
interface Props { lang: Locale; items: Crumb[]; class?: string }
const { lang, items, class: className } = Astro.props;
const d = t(lang).breadcrumb;
---
<nav class:list={['crumbs', className]} aria-label={d.ariaLabel}>
  <ol role="list">
    {items.map((c, i) => (
      <li>
        {i > 0 && <Icon name="chevron-right" size="small" class="crumbs__sep" />}
        {c.href && i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); font-size: var(--fs-small); line-height: var(--lh-small); }
  .crumbs li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .crumbs :global(.crumbs__sep) { color: var(--color-text-muted); }
  .crumbs span { color: var(--color-text-muted); }
</style>
