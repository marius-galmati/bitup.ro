---
/**
 * Cifră-cheie (componente.md § Cifre-cheie): linie de sus 2 px (bleumarin; albă pe închis), cifra în IBM Plex Mono 500 la 32–40 px,
 * descrierea 14 px în culoarea secundară. Pe bleumarin, cifra poate fi portocalie (`accent`). Doar cifre aprobate în copy.md.
 */
interface Props { value: string; caption: string; accent?: boolean; class?: string }
const { value, caption, accent = false, class: className } = Astro.props;
---
<div class:list={['stat', accent && 'stat--accent', className]}>
  <p class="stat__value">{value}</p>
  <p class="stat__caption">{caption}</p>
</div>

<style>
  .stat { display: grid; gap: var(--space-2); padding-top: var(--space-3); border-top: var(--rule-strong) solid var(--color-heading); }
  .stat__value { font-family: var(--font-mono); font-weight: var(--fw-medium); font-size: var(--fs-stat); line-height: 1.1; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  /* Portocaliu doar pe bleumarin (contrast 7,82); pe deschis rămâne bleumarin. */
  :global(.on-navy) .stat--accent .stat__value { color: var(--color-marker); }
  :global(:root[data-theme='dark']) .stat--accent .stat__value { color: var(--color-marker); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .stat--accent .stat__value { color: var(--color-marker); } }
  .stat__caption { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--color-text-muted); }
  .stat__value + .stat__caption { margin-top: 0; }
</style>
