---
/**
 * Faq (DESIGN § Faq): details/summary native, stilizate; prima întrebare deschisă implicit.
 * Generează JSON-LD FAQPage (în limba paginii) când `jsonLd` e true; homepage-ul îl dezactivează (01-acasa: „Fără altceva”).
 */
interface Props { items: { q: string; a: string; link?: { label: string; href: string; after?: string } }[]; jsonLd?: boolean; class?: string; lang?: string }
const { items, jsonLd = true, class: className, lang } = Astro.props;
const graph = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: items.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } })),
};
---
<div class:list={['faq', className]}>
  {items.map((it, i) => (
    <details class="faq__item" open={i === 0}>
      <summary class="faq__q">{it.q}</summary>
      <p class="faq__a">{it.a}{it.link && <> <a href={it.link.href}>{it.link.label}</a>{it.link.after}</>}</p>
    </details>
  ))}
</div>
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />}

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__q { padding: var(--s-4) 0; padding-right: var(--s-7); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); color: var(--navy); cursor: pointer; list-style: none; position: relative; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: '+'; position: absolute; right: var(--s-2); top: var(--s-4); font-weight: 400; color: var(--teal); transition: transform 150ms; }
  .faq__item[open] .faq__q::after { content: '−'; }
  .faq__q:hover { color: var(--teal); }
  .faq__a { padding: 0 0 var(--s-5); max-width: 70ch; }
</style>
