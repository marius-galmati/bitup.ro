---
/**
 * Card (DESIGN § Card): fundal --surface, bordură --line, bordură superioară 3 px teal, padding 20–24 px, h3 + text.
 * Fără umbră, fără iconiță. Înălțimi egale vin din grid-ul părintelui. Linkul, dacă există, e terțiar, jos.
 */
interface Props { title: string; href?: string; linkLabel?: string; class?: string; headingLevel?: 'h3' | 'h2' }
const { title, href, linkLabel, class: className, headingLevel: Tag = 'h3' } = Astro.props;
---
<article class:list={['card', className]}>
  <Tag class="card__title">{title}</Tag>
  <div class="card__body"><slot /></div>
  {href && linkLabel && <a class="card__link" href={href}>{linkLabel}<span aria-hidden="true"> →</span></a>}
</article>

<style>
  .card { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--teal); border-radius: var(--radius); }
  @media (max-width: 767px) { .card { padding: 20px; } }
  .card__title { font-size: var(--fs-h3); }
  .card__body { color: var(--text); }
  .card__body :global(p + p) { margin-top: var(--s-3); }
  .card__link { margin-top: auto; padding-top: var(--s-2); font-family: var(--font-display); font-weight: 600; color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .card__link:hover { color: var(--navy); }
</style>
