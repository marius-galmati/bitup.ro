---
/** Placeholder vizibil pentru o imagine care nu există încă (CLAUDE.md, regula 3): rămâne în pagină exact ca text, într-o casetă cu linie punctată. */
interface Props { name: string; caption?: string; ratio?: string; class?: string }
const { name, caption, ratio = '4 / 3', class: className } = Astro.props;
---
<figure class:list={['ph', className]}>
  <div class="ph__box" style={`aspect-ratio: ${ratio}`}><span>{name}</span></div>
  {caption && <figcaption class="small muted">{caption}</figcaption>}
</figure>

<style>
  .ph { margin: 0; display: grid; gap: var(--s-2); }
  .ph__box { display: grid; place-items: center; border: 1px dashed var(--line); border-radius: var(--r-media); background: var(--surface); color: var(--muted); font-size: var(--fs-small); padding: var(--s-4); }
</style>
