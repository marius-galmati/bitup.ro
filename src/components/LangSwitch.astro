---
/**
 * LangSwitch (DESIGN § LangSwitch): două linkuri, RO · EN, mono 12.5 px; limba curentă în --text 600 (fără link), cealaltă în --muted, link către pagina pereche.
 * Fără steaguri. `hreflang` și `lang` pe linkul celeilalte limbi.
 */
import { t, type Locale } from '../i18n';
interface Props { lang: Locale; altHref: string; compact?: boolean; class?: string }
const { lang, altHref, compact = false, class: className } = Astro.props;
const dict = t(lang);
---
<nav class:list={['lang', { 'lang--compact': compact }, className]} aria-label={dict.langSwitch.ariaLabel}>
  {/* Ordinea e mereu RO · EN; limba curentă e text, cealaltă e link. */}
  {lang === 'ro'
    ? <span class="lang__current" aria-current="true" lang="ro">{dict.langSwitch.ro}</span>
    : <a class="lang__other" href={altHref} hreflang="ro" lang="ro" data-event="lang_switch">{dict.langSwitch.ro}</a>}
  <span class="lang__sep" aria-hidden="true">·</span>
  {lang === 'en'
    ? <span class="lang__current" aria-current="true" lang="en">{dict.langSwitch.en}</span>
    : <a class="lang__other" href={altHref} hreflang="en" lang="en" data-event="lang_switch">{dict.langSwitch.en}</a>}
</nav>

<style>
  .lang { font-family: var(--font-mono); font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: .04em; white-space: nowrap; display: inline-flex; align-items: center; gap: var(--s-1); }
  .lang__current { color: var(--text); font-weight: 500; padding-block: var(--s-2); }
  .lang__sep { color: var(--muted); }
  .lang__other { color: var(--muted); text-decoration: none; padding-block: var(--s-2); }
  .lang__other:hover { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .lang--compact .lang__current, .lang--compact .lang__sep { display: none; }
</style>
