---
/**
 * LangSwitch (DESIGN § LangSwitch): comutator în două segmente, RO | EN, într-o bordură de 1 px `--line` cu `--r-pill`.
 * Limba curentă e plină (`--navy` cu text `--surface`, deci inversată automat în dark) și nu e link; cealaltă e link `--text`
 * către pagina pereche, cu hover `--surface-2` + `--teal`. Public Sans 14 px 600. 40 px înălțime pe desktop (cât butonul `sm`
 * de lângă), segmente de 44 × 44 px sub 1024 px. Fără steaguri. `hreflang` și `lang` pe linkul celeilalte limbi.
 */
import { t, type Locale } from '../i18n';
interface Props { lang: Locale; altHref: string; class?: string }
const { lang, altHref, class: className } = Astro.props;
const dict = t(lang);
---
<nav class:list={['lang', className]} aria-label={dict.langSwitch.ariaLabel}>
  {/* Ordinea e mereu RO, EN; limba curentă e text, cealaltă e link. */}
  {lang === 'ro'
    ? <span class="lang__seg lang__current" aria-current="true" lang="ro">{dict.langSwitch.ro}</span>
    : <a class="lang__seg lang__other" href={altHref} hreflang="ro" lang="ro" data-event="lang_switch">{dict.langSwitch.ro}</a>}
  {lang === 'en'
    ? <span class="lang__seg lang__current" aria-current="true" lang="en">{dict.langSwitch.en}</span>
    : <a class="lang__seg lang__other" href={altHref} hreflang="en" lang="en" data-event="lang_switch">{dict.langSwitch.en}</a>}
</nav>

<style>
  /* 40 px în total pe desktop, cât `.btn--small` din dreapta lui; segmentele umplu înălțimea. */
  .lang { display: inline-flex; align-items: stretch; gap: 0; height: 40px; padding: var(--s-1); border: 1px solid var(--line); border-radius: var(--r-pill); background: var(--surface); font-size: var(--fs-label); font-weight: 600; line-height: 1; white-space: nowrap; }
  .lang__seg { display: inline-flex; align-items: center; justify-content: center; min-width: var(--s-7); padding-inline: var(--s-3); border-radius: var(--r-pill); }
  /* Zonă de atingere de 44 × 44 px sub 1024 px, unde meniul mobil e singurul comutator de limbă (DESIGN § Accesibilitate). */
  @media (max-width: 1023px) { .lang { height: auto; } .lang__seg { min-height: 44px; min-width: 56px; } }
  .lang__current { background: var(--navy); color: var(--surface); }
  .lang__other { color: var(--text); text-decoration: none; transition: background-color 150ms, color 150ms; }
  .lang__other:hover { background: var(--surface-2); color: var(--teal); }
  .lang__other:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .lang__other { transition: none; } }
</style>
