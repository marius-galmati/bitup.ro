---
/** Prose (DESIGN § Prose): text lung (articole, legal): 17 px / 1.65, h2 cu 36 px sus, liste simple, linkuri subliniate, 70ch. */
interface Props { class?: string; lang?: string }
const { class: className, lang } = Astro.props;
---
<div class:list={['prose', className]} lang={lang}><slot /></div>

<style is:global>
  .prose { font-size: var(--fs-body); line-height: 1.65; max-width: 70ch; hyphens: auto; }
  .prose > * + * { margin-top: var(--s-4); }
  .prose h2 { margin-top: 36px; font-size: var(--fs-h2); }
  .prose h3 { margin-top: var(--s-5); font-size: var(--fs-h3); }
  .prose h2 + *, .prose h3 + * { margin-top: var(--s-3); }
  .prose p { text-wrap: pretty; }
  .prose ul, .prose ol { padding-left: var(--s-5); }
  .prose li + li { margin-top: var(--s-2); }
  .prose li::marker { color: var(--teal); }
  .prose a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .prose a:hover { color: var(--navy); }
  .prose blockquote { margin: 0; padding: var(--s-4) var(--s-5); background: var(--teal-soft); border-left: 4px solid var(--teal); font-style: italic; }
  .prose code { font-family: var(--font-mono); font-size: .92em; background: var(--surface-2); padding: 1px var(--s-1); border-radius: var(--radius); }
  .prose table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .prose th, .prose td { text-align: left; vertical-align: top; padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--line); }
  .prose th { font-family: var(--font-display); font-weight: 600; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin-block: var(--s-6); }
  .prose strong { font-weight: 600; }
</style>
