---
/** NumberTiles (DESIGN § NumberTiles): plăci navy cu cifra mare și explicația în --on-navy-muted. Doar cifre reale. Niciodată animate. */
interface Props { items: { v: string; unit?: string; k: string }[]; class?: string }
const { items, class: className } = Astro.props;
---
<ul class:list={['tiles', className]}>
  {items.map((it) => (
    <li class="tile">
      <p class="tile__v"><span class="tile__num">{it.v}</span>{it.unit && <span class="tile__unit"> {it.unit}</span>}</p>
      <p class="tile__k">{it.k}</p>
    </li>
  ))}
</ul>

<style>
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .tile { padding: var(--s-5); background: var(--navy-surface); border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: var(--s-2); align-content: start; }
  .tile__v { font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 3vw, 40px); line-height: 1; color: var(--on-navy); font-variant-numeric: tabular-nums; }
  .tile__unit { font-size: var(--fs-h3); font-weight: 600; }
  .tile__k { color: var(--on-navy-muted); font-size: var(--fs-small); }
</style>
