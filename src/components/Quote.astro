---
/** Quote (DESIGN § Quote): fundal --teal-soft, bordură stânga 4 px teal, italic, sursă în --muted. Doar cu nume și funcție reale. */
interface Props { name: string; role?: string; class?: string }
const { name, role, class: className } = Astro.props;
---
<figure class:list={['quote', className]}>
  <blockquote class="quote__text"><slot /></blockquote>
  <figcaption class="quote__source">{name}{role && <span>, {role}</span>}</figcaption>
</figure>

<style>
  /* DESIGN § Quote (26 sept. 2026): --teal-soft, --r-card, padding --s-8, fără bordură laterală. */
  .quote { margin: 0; padding: var(--s-8); background: var(--teal-soft); border-radius: var(--r-card); display: grid; gap: var(--s-3); }
  .quote__text { margin: 0; font-style: italic; font-size: var(--fs-lead); line-height: 1.5; color: var(--text); }
  .quote__source { color: var(--muted); font-size: var(--fs-small); }
</style>
