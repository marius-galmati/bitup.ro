---
/**
 * ThemeToggle (ARHITECTURA § Dark mode, DESIGN § Dark mode): buton 36×36 cu iconiță soare/lună, două stări (light/dark),
 * pornind de la preferința sistemului. Salvează în localStorage['bitup-theme']. aria-label din i18n; aria-pressed = dark.
 */
import { Icon } from 'astro-icon/components';
interface Props { label: string; class?: string }
const { label, class: className } = Astro.props;
---
<button type="button" class:list={['theme-toggle', className]} data-theme-toggle aria-label={label} title={label} aria-pressed="false" data-event="theme_toggle">
  <Icon name="lucide:moon" class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true" />
  <Icon name="lucide:sun" class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true" />
</button>

<style>
  .theme-toggle { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 1px solid transparent; border-radius: var(--radius); background: none; color: var(--muted); cursor: pointer; transition: color 150ms, border-color 150ms; }
  .theme-toggle:hover { color: var(--teal); }
  .theme-toggle__icon { width: 20px; height: 20px; stroke-width: 1.75; }
  .theme-toggle__icon--sun { display: none; }
  :root[data-theme="dark"] .theme-toggle__icon--moon { display: none; }
  :root[data-theme="dark"] .theme-toggle__icon--sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle__icon--moon { display: none; }
    :root:not([data-theme="light"]) .theme-toggle__icon--sun { display: block; }
  }
</style>

<script>
  const KEY = 'bitup-theme';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.getAttribute('data-theme') ?? (media.matches ? 'dark' : 'light');
  const sync = () => {
    const dark = current() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(dark)));
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem(KEY, next); } catch {}
      sync();
    });
  });
  media.addEventListener('change', sync);
  sync();
</script>
