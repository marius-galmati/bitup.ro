---
/**
 * Graficul din hero-ul homepage-ului (16 octombrie 2026, cerut de Marius): cinci straturi izometrice, după
 * `ce-facem_01_animat.mp4` (7 s, 1080 × 1350). Înlocuiește HeroDiagram („De la fragmentare / La progres”).
 *
 * Geometria e cea din video, în pixelii cadrului: romburi 2:1 cu semi-axele 230 × 115, centrate pe x = 318;
 * vârful stâng al fiecărui strat la y = 1031 / 975 / 888 / 801 / 680 (straturile 1…5), grosimi 22 / 10 / 10 / 10 / 12.
 * Etichetele, la dreapta, sunt centrate pe y = 1040 / 972 / 885 / 797 / 677. Culorile vin din tokeni
 * (fundația are trei tokeni proprii, aceiași în ambele teme), deci dark mode-ul e automat.
 *
 * Mișcare, toată din CSS (JavaScript doar pornește și oprește bucla):
 *   1. La încărcare, o singură dată: fundația apare, apoi straturile 2…5 cad pe rând de la 45 de unități mai sus,
 *      la 0,62 s unul de altul (320 ms fiecare), iar eticheta fiecăruia apare după ce stratul s-a așezat. ~2,8 s.
 *   2. Cât timp mouse-ul stă pe desen, se repetă ciclul din video, rotit ca să înceapă cu demontarea:
 *      straturile 5…2 pleacă în sus (200 ms, la 100 ms unul de altul), rămâne fundația, se reconstruiesc ca la
 *      încărcare, apoi stiva stă întreagă 3,3 s. 7 s pe ciclu, ca în video. Ciclul început se termină mereu,
 *      deci stiva rămâne întreagă când mouse-ul pleacă.
 * Cu `prefers-reduced-motion: reduce`, nimic nu se mișcă: stiva apare direct întreagă.
 *
 * Etichetele sunt HTML, nu text SVG: o listă ordonată de linkuri către paginile serviciilor (ca benzile din
 * HeroDiagram), cu mărimea legată de lățimea graficului (`cqw`), ca proporțiile din video să se păstreze.
 * Desenul e decorativ (`aria-hidden`); lista are numele graficului ca `aria-label`.
 */
import { t, localePath, anchors, type Locale } from '../../i18n';

interface Props { lang: Locale; class?: string }
const { lang, class: className } = Astro.props;
const d = t(lang).heroStack;

const CX = 318, W = 230, H = 115;
/** Straturile de jos în sus: vârful stâng (y), grosimea, centrul etichetei (y), destinația linkului. */
const STRATURI = [
  { y: 1031, g: 22, ey: 1040, href: localePath('security', lang) },
  { y: 975, g: 10, ey: 972, href: localePath('itSupport', lang) },
  { y: 888, g: 10, ey: 885, href: localePath('automation', lang, anchors.automation[lang].software) },
  { y: 801, g: 10, ey: 797, href: localePath('automation', lang) },
  { y: 680, g: 12, ey: 677, href: localePath('automation', lang) },
].map((s, i) => ({ ...s, n: i + 1, nume: d.straturi[i] }));

// Fereastra desenului, în pixelii cadrului: x 84…552, y 550…1175 (loc pentru grosimea fundației).
const VB = { x: 84, y: 550, w: 468, h: 625 };
const pct = (y: number) => `${(((y - VB.y) / VB.h) * 100).toFixed(2)}%`;

const p = (pts: number[][]) => pts.map(([x, y]) => `${x},${y}`).join(' ');
const fete = (y: number, g: number) => ({
  sus: p([[CX, y - H], [CX + W, y], [CX, y + H], [CX - W, y]]),
  stanga: p([[CX - W, y], [CX, y + H], [CX, y + H + g], [CX - W, y + g]]),
  dreapta: p([[CX, y + H], [CX + W, y], [CX + W, y + g], [CX, y + H + g]]),
});

// Încărcarea: când pornește fiecare strat (ms). Fundația la 0; apoi pasul din video, 0,62 s.
const START = [0, 450, 1070, 1690, 2310];
---
<figure class:list={['hs', className]} data-hstack>
  <svg class="hs__art" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} aria-hidden="true" focusable="false">
    {STRATURI.map((s, i) => {
      const f = fete(s.y, s.g);
      return (
        <g class:list={['hs__layer', `hs__layer--${s.n}`]} style={`--d: ${START[i]}ms`}>
          <polygon class="hs__left" points={f.stanga} />
          <polygon class="hs__right" points={f.dreapta} />
          <polygon class="hs__top" points={f.sus} />
        </g>
      );
    })}
  </svg>
  <ol class="hs__labels" reversed aria-label={d.ariaLabel}>
    {[...STRATURI].reverse().map((s) => (
      <li class:list={['hs__label', `hs__label--${s.n}`]} style={`--y: ${pct(s.ey)}; --d: ${START[s.n - 1] + (s.n === 1 ? 150 : 330)}ms`}>
        <a class="hs__link" href={s.href}>
          <span class="hs__dash" aria-hidden="true"></span>
          <span class="hs__num" aria-hidden="true">{s.n}</span>
          <span class="hs__name">{s.nume}</span>
        </a>
        {s.n === 1 && <span class="hs__note"><span class="hs__note-text">{d.fundatia}</span></span>}
      </li>
    ))}
  </ol>
</figure>

<script>
  // Bucla de la hover: pornește când mouse-ul intră pe desen și se repetă cât timp stă acolo; ciclul început se
  // termină mereu (stiva rămâne întreagă). `is-ready` scoate animația de încărcare după ce s-a terminat, ca
  // bucla să nu o repornească. Fără JavaScript rămâne doar secvența de la încărcare.
  const fig = document.querySelector<HTMLElement>('[data-hstack]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (fig && !reduce.matches) {
    const art = fig.querySelector<SVGElement>('.hs__art')!;
    const last = fig.querySelector<HTMLElement>('.hs__label--5')!; // ultimul lucru care se mișcă, și la încărcare, și în buclă
    let hovering = false;
    const ready = () => fig.classList.add('is-ready');
    const start = () => { if (fig.classList.contains('is-ready') && !fig.classList.contains('is-cycling')) fig.classList.add('is-cycling'); };
    last.addEventListener('animationend', () => {
      if (!fig.classList.contains('is-ready')) { ready(); if (hovering) start(); return; }
      fig.classList.remove('is-cycling');
      if (hovering) { void fig.offsetWidth; fig.classList.add('is-cycling'); }
    });
    window.setTimeout(ready, 3500); // plasă de siguranță, dacă `animationend` nu vine
    art.addEventListener('pointerenter', () => { hovering = true; start(); });
    art.addEventListener('pointerleave', () => { hovering = false; });
  }
</script>

<style>
  /* --art: cât din lățime ia desenul (în video, 468 din 920); etichetele încep imediat după. */
  /* --dl / --dw / --dr: marginea, lungimea și golul liniuței dinaintea cifrei (în video: 14, 26, 23 de unități la un corp de 32). */
  .hs { --art: 50.9%; --fs: clamp(14px, 3.1cqw, 19px); --dl: .45em; --dw: .8em; --dr: .7em; position: relative; margin: 0; width: 100%; container-type: inline-size; }
  .hs__art { display: block; width: var(--art); height: auto; overflow: visible; }

  /* Straturile 2…4: deschise, conturul de sus subțire; laturile semitransparente, ca în video. */
  .hs__top { fill: var(--surface-2); stroke: var(--muted); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .hs__left { fill: var(--line); }
  .hs__right { fill: var(--line); opacity: .55; }
  /* Stratul 5: alb, cu muchie și laturi orange. */
  .hs__layer--5 .hs__top { fill: var(--surface); stroke: var(--orange); stroke-width: 2; }
  .hs__layer--5 .hs__left { fill: var(--orange); }
  .hs__layer--5 .hs__right { fill: var(--orange); opacity: .55; }
  /* Stratul 1, fundația: teal plin, laturi navy. */
  .hs__layer--1 .hs__top { fill: var(--stack-base-top); stroke: none; }
  .hs__layer--1 .hs__left { fill: var(--stack-base-left); }
  .hs__layer--1 .hs__right { fill: var(--stack-base-right); opacity: 1; }

  .hs__labels { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; }
  .hs__label { position: absolute; top: var(--ym, var(--y)); left: var(--art); translate: 0 -50%; font-size: var(--fs); line-height: 1.2; pointer-events: auto; }
  .hs__link { display: inline-flex; align-items: center; gap: 0; padding-left: var(--dl); color: var(--text); text-decoration: none; border-radius: var(--r-field); }
  .hs__dash { display: inline-block; width: var(--dw); height: 1px; margin-right: var(--dr); background: var(--muted); opacity: .6; }
  .hs__num { min-width: .9em; margin-right: .6em; font-weight: 500; color: var(--teal); font-variant-numeric: tabular-nums; }
  .hs__label--5 .hs__num { color: var(--orange); }
  .hs__name { font-weight: 600; white-space: nowrap; }
  /* Sub nume, cu același decalaj ca numele: poziția e în unitățile etichetei, corpul mai mic (minimum 12 px) e pe textul dinăuntru. */
  .hs__note { position: absolute; top: 100%; left: calc(var(--dl) + var(--dw) + var(--dr) + .9em + .6em); line-height: 1.2; white-space: nowrap; }
  .hs__note-text { font-size: max(12px, .7em); color: var(--muted); }
  .hs__link:hover .hs__name { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .hs__link:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }

  /* Pe telefon desenul se strânge și liniuța dispare, ca „Securitate cibernetică” și „Software development” să încapă pe un rând. */
  @media (max-width: 479px) { .hs { --art: 42%; --dl: .8em; --dw: 0px; --dr: 0px; } .hs__dash { display: none; } }
  /* Tot pe telefon, etichetele 1–3 se distanțează egal (13,4 % din înălțime), ca linkurile să aibă 24 px între ele
     (WCAG 2.5.8; în proporțiile din video, 1 și 2 stau la 20 px). Diferența față de strat e de cel mult 3 px, iar liniuța lipsește aici. */
  @media (max-width: 479px) { .hs__label--3 { --ym: 53.2%; } .hs__label--2 { --ym: 66.6%; } .hs__label--1 { --ym: 80%; } }

  /* 1. Încărcarea, o singură dată. */
  @keyframes hs-drop { from { opacity: 0; transform: translateY(-45px); } to { opacity: 1; transform: none; } }
  @keyframes hs-fade { from { opacity: 0; } to { opacity: 1; } }
  .hs:not(.is-ready) .hs__layer { animation: hs-drop 320ms cubic-bezier(.2, .7, .3, 1) var(--d) both; }
  .hs:not(.is-ready) .hs__layer--1 { animation: hs-fade 300ms ease-out var(--d) both; }
  .hs:not(.is-ready) .hs__label { animation: hs-fade 200ms ease-out var(--d) both; }

  /* 2. Bucla de la hover: ciclul de 7 s din video, rotit să înceapă cu demontarea (1 % = 70 ms).
        Plecare: stratul n la (5 − n) × 100 ms, 200 ms. Sosire: la 1300 + (n − 2) × 620 ms, 320 ms; eticheta la +330 ms, 200 ms. */
  @keyframes hs-c5 { 0% { opacity: 1; transform: none; animation-timing-function: ease-in; } 2.857% { opacity: 0; transform: translateY(-25px); } 45.143% { opacity: 0; transform: translateY(-45px); animation-timing-function: cubic-bezier(.2, .7, .3, 1); } 49.714%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-c4 { 0%, 1.429% { opacity: 1; transform: none; animation-timing-function: ease-in; } 4.286% { opacity: 0; transform: translateY(-25px); } 36.286% { opacity: 0; transform: translateY(-45px); animation-timing-function: cubic-bezier(.2, .7, .3, 1); } 40.857%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-c3 { 0%, 2.857% { opacity: 1; transform: none; animation-timing-function: ease-in; } 5.714% { opacity: 0; transform: translateY(-25px); } 27.429% { opacity: 0; transform: translateY(-45px); animation-timing-function: cubic-bezier(.2, .7, .3, 1); } 32%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-c2 { 0%, 4.286% { opacity: 1; transform: none; animation-timing-function: ease-in; } 7.143% { opacity: 0; transform: translateY(-25px); } 18.571% { opacity: 0; transform: translateY(-45px); animation-timing-function: cubic-bezier(.2, .7, .3, 1); } 23.143%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-e5 { 0% { opacity: 1; transform: none; animation-timing-function: ease-in; } 2.857% { opacity: 0; transform: translateY(-.75em); } 49.857% { opacity: 0; transform: none; animation-timing-function: ease-out; } 52.714%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-e4 { 0%, 1.429% { opacity: 1; transform: none; animation-timing-function: ease-in; } 4.286% { opacity: 0; transform: translateY(-.75em); } 41% { opacity: 0; transform: none; animation-timing-function: ease-out; } 43.857%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-e3 { 0%, 2.857% { opacity: 1; transform: none; animation-timing-function: ease-in; } 5.714% { opacity: 0; transform: translateY(-.75em); } 32.143% { opacity: 0; transform: none; animation-timing-function: ease-out; } 35%, 100% { opacity: 1; transform: none; } }
  @keyframes hs-e2 { 0%, 4.286% { opacity: 1; transform: none; animation-timing-function: ease-in; } 7.143% { opacity: 0; transform: translateY(-.75em); } 23.286% { opacity: 0; transform: none; animation-timing-function: ease-out; } 26.143%, 100% { opacity: 1; transform: none; } }
  .hs.is-cycling .hs__layer--5 { animation: hs-c5 7s linear both; }
  .hs.is-cycling .hs__layer--4 { animation: hs-c4 7s linear both; }
  .hs.is-cycling .hs__layer--3 { animation: hs-c3 7s linear both; }
  .hs.is-cycling .hs__layer--2 { animation: hs-c2 7s linear both; }
  .hs.is-cycling .hs__label--5 { animation: hs-e5 7s linear both; }
  .hs.is-cycling .hs__label--4 { animation: hs-e4 7s linear both; }
  .hs.is-cycling .hs__label--3 { animation: hs-e3 7s linear both; }
  .hs.is-cycling .hs__label--2 { animation: hs-e2 7s linear both; }

  @media (prefers-reduced-motion: reduce) {
    .hs .hs__layer, .hs .hs__label { animation: none !important; }
  }
</style>
