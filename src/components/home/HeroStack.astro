---
/**
 * Graficul din hero-ul homepage-ului: stiva de cinci plăci izometrice. Din 25 octombrie 2026 e modelul generat de
 * Marius (HTML + CSS + JS „3D Isometric Layer Stack Hero Animation”), care înlocuiește complet varianta cu
 * rotație 3D. Geometria e cea din model: romburi cu semi-axele 135 × 72, centrate pe x = 230, plăcile la
 * y = 330 / 280 / 230 / 180 / 130 (straturile 1…5), grosimi 26 / 18 / 18 / 18 / 20.
 *
 * Interacțiune (din model): când mouse-ul stă pe o placă, placa iese puțin în față (−14 px pe orizontală, 1,03×),
 * iconița serviciului se ridică deasupra ei, plăcile de deasupra urcă 48 de unități, cele de dedesubt coboară 48, ambele
 * cu un blur de mișcare pe verticală și 88 % opacitate. În repaus se vede doar iconița de pe stratul 5. Clic pe placă =
 * linkul serviciului.
 *
 * Etichetele (25 octombrie 2026, cerut de Marius): nu mai stau într-o coloană lângă desen, ci apar doar pe placa activă,
 * deasupra iconiței ridicate, cu numele serviciului (fără cifră și fără descriere; la fundație, „· fundația”). Rămân
 * linkuri HTML: tastatura le atinge cu Tab și focusul activează placa. Pe ecran tactil, prima atingere pe o placă o
 * activează (se vede eticheta), a doua deschide linkul.
 *
 * Mișcare adăugată peste model (25 octombrie 2026, cerut de Marius):
 *   1. La încărcare, o singură dată: fundația apare, apoi plăcile 2…5 cad pe rând una peste alta, de la 45 de unități
 *      mai sus, la 0,62 s una de alta (360 ms fiecare, ease-out-quint). ~2,7 s. Căderea folosește proprietatea
 *      `translate`, ca să nu se bată cu `transform` din starea activă.
 *   2. Apoi stiva face o tură completă (360°, 3 s), în jurul axei verticale, și se oprește cum a început.
 *   3. Tras cu mouse-ul sau cu degetul pe orizontală, stiva se rotește (0,5° pe pixel, cu inerție); la eliberare se
 *      așază în cea mai apropiată poziție de repaus. Un clic fără tragere rămâne link. Geometria rotită vine din
 *      `heroStack3d.ts` (aceeași la build și în browser); laturile își schimbă nuanța după unghiul față de lumină.
 * Cu `prefers-reduced-motion`: fără cădere și fără rotație; stările active se schimbă fără tranziție.
 *
 * Abaterile de la model, cerute de regulile proiectului: culorile vin din tokeni (dark mode automat; paleta slate /
 * blue / indigo a modelului e paleta implicită Tailwind), iconițele emoji sunt înlocuite cu echivalentele din lucide,
 * iar etichetele rămân linkuri către paginile serviciilor.
 *
 * v3 (28 octombrie 2026, cerut de Marius): stiva se copiază exact cum e pe bitup.ro (geometria, animațiile, umbrele și
 * blurul, inclusiv geometria din heroStack3d.ts, neschimbată). Se schimbă doar: fontul etichetelor (IBM Plex Sans, din
 * tokens), linkurile (cele 5 pagini noi de servicii), „Securitate cibernetică · fundația”, fundația teal ca în manual,
 * culorile scrise ca tokens sau valori derivate (blocul „HeroStack” din global.css, aceleași nuanțe ca până acum) și
 * colțurile etichetei (2 px, maximul din brand; erau 12). Umbrele și blurul rămân aici, la cererea lui Marius; în
 * restul site-ului regula „fără umbre” se aplică (qa/tokens-only.mjs are excepția doar pentru fișierul ăsta).
 */
import { Icon } from 'astro-icon/components';
import { t, localePath, type Locale } from '../../i18n';
import { placa, REST, CX } from './heroStack3d';

interface Props { lang: Locale; class?: string }
const { lang, class: className } = Astro.props;
const d = t(lang).heroStack;

/** De jos în sus: poziția plăcii (y), grosimea, iconița (lucide), destinația linkului. */
const STRATURI = [
  { y: 330, g: 26, icon: 'shield', href: localePath('security', lang) },
  { y: 280, g: 18, icon: 'cloud', href: localePath('infrastructure', lang) },
  { y: 230, g: 18, icon: 'code-xml', href: localePath('software', lang) },
  { y: 180, g: 18, icon: 'zap', href: localePath('automation', lang) },
  { y: 130, g: 20, icon: 'sparkles', href: localePath('aiAgents', lang) },
].map((s, i) => ({ ...s, n: i + 1, nume: d.straturi[i] }));

// Încărcarea: când începe să cadă fiecare placă (ms). Fundația la 0; apoi pasul din ce-facem_01_animat.mp4, 0,62 s.
const START = [0, 450, 1070, 1690, 2310];

// Fereastra desenului: strânsă pe plăcile în repaus (x 95…365, y 58…428), ca desenul să fie cât mai mare în lățimea
// lui. Umbrele, plăcile depărtate din starea activă, iconița ridicată și eticheta ies din fereastră (`overflow: visible`).
const VB = { x: 88, y: 50, w: 284, h: 386 };

// Eticheta stă deasupra iconiței ridicate a plăcii active. Placa activă: translateY(y) translateX(−14) scale(1,03), cu
// originea în (0, 0); iconița: −62 de unități și 1,52× în jurul centrului discului (r = 24), deci marginea de sus a
// discului e la x = 1,03 × 230 − 14, y = y − 1,03 × (62 + 1,52 × 24). Eticheta se termină cu 8 unități mai sus.
const ICON_X = 1.03 * CX - 14;
const eticheta = (y: number) => ({
  lx: ((ICON_X - VB.x) / VB.w) * 100,
  ly: ((y - 1.03 * (62 + 1.52 * 24) - 8 - VB.y) / VB.h) * 100,
});
---
<figure class:list={['hs', className]} data-hstack>
  <div class="hs__stage">
    <svg class="hs__art" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} aria-hidden="true" focusable="false">
      <defs>
        <filter id="hs-motion-blur" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur in="SourceGraphic" stdDeviation="0 3" /></filter>
        {/* Umbrele de sub plăci: în model, `feDropShadow` pe fețele de sus. Aici, gradienți radiali cu același decalaj și
            aceeași intensitate: un filtru de blur se recalculează la fiecare cadru al căderii și al rotației (pe un telefon
            lent, ~2 s de fir principal blocat la încărcare), un gradient nu. */}
        <radialGradient id="hs-soft-ambient"><stop class="hs__soft hs__soft--ambient" offset="0" /><stop class="hs__soft hs__soft--ambient" offset=".45" /><stop class="hs__soft hs__soft--end" offset="1" /></radialGradient>
        <radialGradient id="hs-soft-base"><stop class="hs__soft hs__soft--base" offset="0" /><stop class="hs__soft hs__soft--base" offset=".45" /><stop class="hs__soft hs__soft--end" offset="1" /></radialGradient>
      </defs>

      {/* Umbra de pe „podea”, cu forma fundației. */}
      <ellipse class="hs__ground" cx="218" cy="378" rx="165" ry="96" fill="url(#hs-soft-base)" />

      <g class="hs__slabs">
        {STRATURI.map((s, i) => {
          const f = placa(REST, s.g);
          return (
            <g class:list={['hs__slab-pos', 'hs__slab', `hs__slab--${s.n}`]} data-index={i} data-g={s.g} data-href={s.href} style={`--base-y: ${s.y}px; --d: ${START[i]}ms`}>
              {/* Umbra plăcii pe ce e dedesubt: sub fața de sus, decalată în jos (16 unități; la fundație 24), ca în model. */}
              {s.n === 1
                ? <ellipse class="hs__drop" cx={CX} cy="24" rx="160" ry="94" fill="url(#hs-soft-base)" />
                : <ellipse class="hs__drop" cx={CX} cy="16" rx="152" ry="88" fill="url(#hs-soft-ambient)" />}
              {f.laturi.map((l) => (
                <polygon class="hs__side" data-side points={l.pts} style={`--t: ${l.t}${l.vizibil ? '' : '; display: none'}`} />
              ))}
              <polygon class="hs__top" data-top points={f.sus} />
            </g>
          );
        })}
      </g>
      {/* Iconițele stau într-un strat separat, peste toate plăcile, ca iconița ridicată să nu fie acoperită de placa de
          deasupra; fiecare urmează poziția plăcii ei (aceeași tranziție; dintre ele, doar cea a plăcii active primește clasa). */}
      <g class="hs__pins">
        {STRATURI.map((s) => (
          <g class:list={['hs__slab-pos', 'hs__pin', `hs__pin--${s.n}`]} style={`--base-y: ${s.y}px; --d: ${START[s.n - 1]}ms`}>
            <ellipse class="hs__contact" cx={CX} cy="6" rx="18" ry="6" />
            <g class="hs__icon">
              <circle class="hs__icon-disc" cx={CX} cy="0" r="24" />
              <Icon name={`lucide:${s.icon}`} x={CX - 9} y={-9} width={18} height={18} class="hs__glyph" />
            </g>
          </g>
        ))}
      </g>
    </svg>

    <ol class="hs__labels" reversed aria-label={d.ariaLabel}>
      {[...STRATURI].reverse().map((s) => {
        const p = eticheta(s.y);
        return (
          <li class:list={['hs__label', `hs__label--${s.n}`]} data-index={s.n - 1} style={`--lx: ${p.lx.toFixed(2)}%; --ly: ${p.ly.toFixed(2)}%`}>
            <a class="hs__link" href={s.href}>
              <span class="hs__name">{s.nume}</span>
              {s.n === 1 && <span class="hs__sub">· {d.fundatia}</span>}
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</figure>

<script>
  import { placa, REST, QUARTER } from './heroStack3d';

  // Starea activă: o placă (din mouse pe desen, din mouse pe etichetă sau din focus pe etichetă) iese în față, cele de
  // deasupra urcă, cele de dedesubt coboară. Fără JavaScript rămâne stiva în repaus, cu etichetele ca linkuri.
  const fig = document.querySelector<HTMLElement>('[data-hstack]');
  if (fig) {
    const slabs = [...fig.querySelectorAll<SVGGElement>('.hs__slab')];
    const pins = [...fig.querySelectorAll<SVGGElement>('.hs__pin')];
    const labels = [...fig.querySelectorAll<HTMLElement>('.hs__label')];
    let dragged = false; // un clic care încheie o tragere nu e link
    let active: number | null = null;
    let pointer = 'mouse'; // tipul ultimei apăsări pe o placă
    const set = (index: number | null) => {
      active = index;
      fig.classList.toggle('has-hover', index !== null);
      slabs.forEach((el, i) => {
        el.classList.toggle('is-hovered', i === index);
        el.classList.toggle('push-up', index !== null && i > index);
        el.classList.toggle('push-down', index !== null && i < index);
      });
      pins.forEach((el, i) => el.classList.toggle('is-hovered', i === index)); // doar iconița plăcii active se vede
      labels.forEach((l) => l.classList.toggle('is-active', Number(l.dataset.index) === index));
    };
    slabs.forEach((slab, i) => {
      slab.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') set(i); });
      slab.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') set(null); });
      slab.addEventListener('pointerdown', (e) => { pointer = e.pointerType; });
      slab.addEventListener('click', () => {
        if (dragged) return;
        // Pe ecran tactil nu există hover: prima atingere arată eticheta, a doua (pe aceeași placă) deschide linkul.
        if (pointer !== 'mouse' && active !== i) { set(i); return; }
        window.location.href = slab.dataset.href!;
      });
    });
    // O atingere în afara plăcilor și a etichetelor închide starea activă.
    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || active === null) return;
      if (!(e.target as Element).closest?.('.hs__slab, .hs__label')) set(null);
    });
    labels.forEach((l) => {
      const i = Number(l.dataset.index);
      l.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') set(i); });
      l.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') set(null); });
      l.addEventListener('focusin', () => set(i));
      l.addEventListener('focusout', () => set(null));
    });

    // Căderea de la încărcare e în CSS; `is-ready` o scoate după ce s-a așezat ultima placă. Rotația vine după.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const art = fig.querySelector<SVGSVGElement>('.hs__art')!;
    const tops = slabs.map((sl) => sl.querySelector<SVGPolygonElement>('[data-top]')!);
    const sides = slabs.map((sl) => [...sl.querySelectorAll<SVGPolygonElement>('[data-side]')]);
    const groz = slabs.map((sl) => Number(sl.dataset.g));
    const draw = (yaw: number) => {
      slabs.forEach((_, i) => {
        const p = placa(yaw, groz[i]);
        tops[i].setAttribute('points', p.sus);
        p.laturi.forEach((l, j) => {
          const el = sides[i][j];
          el.style.display = l.vizibil ? '' : 'none';
          if (!l.vizibil) return;
          el.setAttribute('points', l.pts);
          el.style.setProperty('--t', String(l.t));
        });
      });
    };

    const DEG = Math.PI / 180, SPIN_MS = 3000;
    let yaw = REST, target = REST, raf = 0;
    let spin: number | null = null; // momentul în care a început tura de după încărcare
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const rest = (a: number) => REST + Math.round((a - REST) / QUARTER) * QUARTER; // cea mai apropiată poziție de repaus
    const frame = (now: number) => {
      if (spin !== null) {
        const p = Math.min(1, (now - spin) / SPIN_MS);
        yaw = target = REST + 2 * Math.PI * ease(p);
        if (p >= 1) { spin = null; yaw = target = REST; }
      } else {
        yaw += (target - yaw) * 0.14; // inerție: stiva ajunge din urmă mâna, nu sare
        if (Math.abs(target - yaw) < 0.0005) yaw = target;
      }
      draw(yaw);
      raf = spin !== null || yaw !== target ? requestAnimationFrame(frame) : 0;
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(frame); };

    let ready = false;
    const onReady = () => {
      if (ready) return;
      ready = true;
      fig.classList.add('is-ready');
      // Tura pornește doar dacă tab-ul e vizibil (28 octombrie 2026): o pagină deschisă în fundal nu o mai joacă la revenire.
      // În repaus nu rămâne nimic activ: bucla rAF se oprește când stiva s-a așezat, iar blurul există doar în starea activă.
      if (!reduce) { fig.classList.add('is-live'); if (!document.hidden) { spin = performance.now(); go(); } }
    };
    if (reduce) onReady();
    else {
      fig.querySelector('.hs__slab--5')!.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName === 'hs-drop') onReady(); });
      window.setTimeout(onReady, 3500); // plasă de siguranță, dacă `animationend` nu vine
    }

    // Tragerea: peste 6 px pe orizontală devine rotație (și oprește tura, dacă încă merge); sub atât rămâne clic.
    let downX: number | null = null, lastX = 0, dragging = false;
    art.addEventListener('pointerdown', (e) => { if (!ready || reduce || e.button !== 0) return; downX = lastX = e.clientX; });
    art.addEventListener('pointermove', (e) => {
      if (downX === null) return;
      if (!dragging && Math.abs(e.clientX - downX) > 6) {
        dragging = true;
        art.setPointerCapture(e.pointerId);
        fig.classList.add('is-dragging');
        set(null);
        if (spin !== null) { spin = null; target = yaw; }
      }
      if (dragging) { target += (e.clientX - lastX) * 0.5 * DEG; go(); }
      lastX = e.clientX;
    });
    const release = () => {
      if (dragging) {
        dragged = true;
        window.setTimeout(() => { dragged = false; }, 0);
        fig.classList.remove('is-dragging');
        target = rest(target);
        go();
      }
      downX = null;
      dragging = false;
    };
    art.addEventListener('pointerup', release);
    art.addEventListener('pointercancel', release);
  }
</script>

<style>
  .hs { margin: 0; width: 100%; container-type: inline-size; user-select: none; }
  /* Desenul, centrat în coloana graficului; etichetele stau peste el (25 octombrie 2026, cerut de Marius). */
  .hs__stage { position: relative; width: min(100%, 420px); margin-inline: auto; }
  .hs__art { display: block; width: 100%; height: auto; overflow: visible; }

  /* Plăcile 2…4: fața de sus --hs-surface, laturile din --hs-line (stânga mai închisă, în umbră). */
  .hs__slab-pos { transform: translateY(var(--base-y)); transition: transform .45s cubic-bezier(.16, 1, .3, 1), filter .25s ease, opacity .3s ease; }
  .hs__slab { cursor: pointer; }
  /* Rotația cu degetul e doar pe orizontală; derularea pe verticală rămâne a paginii. */
  .hs.is-live .hs__art { touch-action: pan-y; }
  .hs.is-dragging, .hs.is-dragging .hs__slab { cursor: grabbing; }
  .hs__top { fill: var(--hs-surface); stroke: var(--hs-line); stroke-width: 1.5; stroke-linejoin: round; }
  /* Laturile: între nuanța din umbră (--side-dark) și cea din lumină (--side-light), după --t, calculat din unghiul
     plăcii (heroStack3d.ts). În repaus, latura stângă e cea din umbră și cea dreaptă cea luminată, ca în model. */
  .hs__slab { --side-dark: color-mix(in oklab, var(--hs-line), var(--hs-shade) 10%); --side-light: var(--hs-line); }
  .hs__side { fill: color-mix(in oklab, var(--side-dark), var(--side-light) calc(var(--t) * 100%)); }
  /* Stratul 5: alb, cu muchie și laturi orange. */
  .hs__slab--5 .hs__top { stroke: var(--bu-orange); stroke-width: 5; }
  .hs__slab--5 { --side-dark: color-mix(in oklab, var(--bu-orange), var(--hs-shade) 12%); --side-light: var(--bu-orange); }
  /* Stratul 1, fundația: teal, ca în manual (28 octombrie 2026, ales de Marius); în dark, cu o treaptă mai deschis, ca înainte. */
  .hs__slab--1 .hs__top { fill: var(--hs-base-top); stroke: var(--hs-base-edge); }
  .hs__slab--1 { --side-dark: var(--hs-base-left); --side-light: var(--hs-base-right); }

  .hs__soft { stop-color: var(--hs-shade); }
  .hs__soft--ambient { stop-opacity: var(--hs-shadow-ambient); }
  .hs__soft--base { stop-opacity: var(--hs-shadow-base); }
  .hs__soft--end { stop-opacity: 0; }
  .hs__drop { pointer-events: none; }

  /* Iconița serviciului: pe un disc, deasupra centrului plăcii. În repaus se vede doar cea de pe stratul 5. */
  .hs__pin { opacity: 0; pointer-events: none; }
  .hs:not(.has-hover) .hs__pin--5, .hs__pin.is-hovered { opacity: 1; }
  .hs__contact { fill: var(--hs-shade); opacity: .12; transform-box: fill-box; transform-origin: center; transition: transform .45s cubic-bezier(.16, 1, .3, 1), opacity .3s ease; }
  .hs__icon { transform-box: view-box; transform-origin: 230px 0; transition: transform .45s cubic-bezier(.34, 1.56, .64, 1), filter .35s ease; }
  .hs__icon-disc { fill: var(--hs-surface); stroke: var(--hs-teal); stroke-width: 2; }
  .hs__glyph { color: var(--hs-teal); }
  .hs__pin--5 .hs__icon-disc { stroke: var(--bu-orange); }
  .hs__pin--5 .hs__glyph { color: var(--bu-orange); }
  .hs__pin--1 .hs__icon-disc { fill: var(--hs-base-left); stroke: var(--hs-base-edge); }
  .hs__pin--1 .hs__glyph { color: var(--hs-base-glyph); }

  /* Starea activă, din model. */
  .hs__slab-pos.is-hovered { transform: translateY(var(--base-y)) translateX(-14px) scale(1.03); }
  .hs__pin.is-hovered .hs__icon { transform: translateY(-62px) scale(1.52); filter: drop-shadow(0 20px 14px color-mix(in srgb, var(--hs-shade) 35%, transparent)); }
  .hs__pin.is-hovered .hs__contact { transform: scale(1.67, 1.83); opacity: .24; }
  .hs__slab-pos.push-up { transform: translateY(calc(var(--base-y) - 48px)) scale(.98); filter: url(#hs-motion-blur); opacity: .88; }
  .hs__slab-pos.push-down { transform: translateY(calc(var(--base-y) + 48px)) scale(.98); filter: url(#hs-motion-blur); opacity: .88; }

  /* Etichetele: ascunse în repaus; eticheta plăcii active apare deasupra iconiței ridicate (poziția, în procente din
     fereastra desenului, vine din frontmatter). Rămân în pagină, ca linkuri: focusul le arată, ca și starea activă. */
  .hs__labels { list-style: none; margin: 0; padding: 0; }
  /* Totul într-un singur `transform`: lângă `transform`, proprietatea `translate` dispare la minificare. */
  .hs__label { position: absolute; left: var(--lx); top: var(--ly); z-index: 1; white-space: nowrap; opacity: 0; transform: translate(-50%, calc(-100% + 6px)); pointer-events: none; transition: opacity .2s ease, transform .3s cubic-bezier(.16, 1, .3, 1); }
  .hs__label.is-active, .hs__label:focus-within { opacity: 1; transform: translate(-50%, -100%); pointer-events: auto; }
  .hs__link { display: inline-flex; align-items: baseline; gap: var(--space-2); padding: var(--space-1) var(--hs-label-px); font-size: var(--fs-hs-label); line-height: 1.3; color: var(--hs-text); text-decoration: none; background: var(--hs-surface); border: var(--border-width) solid var(--hs-line); border-radius: var(--radius); transition: color .15s ease; }
  .hs__name { font-weight: var(--fw-semibold); }
  .hs__sub { color: var(--hs-muted); }
  .hs__link:hover { color: var(--hs-teal); }
  .hs__link:focus-visible { outline: var(--rule-strong) solid var(--hs-teal); outline-offset: var(--rule-strong); }

  /* Când graficul stă sub butoane (sub 460 px), desenul ia 80 % din lățime. */
  @container (max-width: 459px) {
    .hs__stage { width: 80%; }
  }

  /* 1. Căderea de la încărcare, o singură dată. Opacitatea are curba ei, scurtă (100 ms), ca placa să fie opacă înainte
        să ajungă peste cea de dedesubt. Iconițele cad odată cu plăcile; dintre ele, doar cea de pe stratul 5 se vede. */
  @keyframes hs-drop { from { translate: 0 -45px; } to { translate: 0 0; } }
  @keyframes hs-fade { from { opacity: 0; } to { opacity: 1; } }
