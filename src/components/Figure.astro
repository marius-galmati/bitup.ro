---
/**
 * Figure (DESIGN § Figure): imagine cu legendă (--fs-small, --muted), bordură --line, padding 10 px.
 * Capturile de ecran (`screenshot`) au colțuri --r-media și, în dark, filter: brightness(.92). Fotografiile nu se modifică.
 * Imaginea vine prin slot (un <Image>/<Picture> din astro:assets sau un <img> cu dimensiuni declarate).
 */
interface Props { caption?: string; kind?: 'photo' | 'screenshot' | 'document'; class?: string }
const { caption, kind = 'photo', class: className } = Astro.props;
---
<figure class:list={['figure', `figure--${kind}`, className]}>
  <div class="figure__media"><slot /></div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure { margin: 0; display: grid; gap: var(--s-2); }
  .figure__media { padding: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-media); }
  .figure__media :global(img) { border-radius: 0; }
  .figure--screenshot .figure__media :global(img) { border-radius: var(--r-media); }
  :root[data-theme="dark"] .figure--screenshot .figure__media :global(img) { filter: brightness(.92); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .figure--screenshot .figure__media :global(img) { filter: brightness(.92); } }
  .figure__caption { font-size: var(--fs-small); color: var(--muted); }
</style>
