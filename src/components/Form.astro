---
/**
 * Form (ARHITECTURA § Formulare, DESIGN § Form). Faza 4a: etichete vizibile, câmpuri obligatorii marcate, honeypot `website` ascuns cu CSS,
 * Turnstile (cheie publică din astro:env), validare în browser cu mesajele din 00-global, trimitere prin fetch JSON către /api/lead (timeout 10 s),
 * stări: se trimite / eroare (textul rămâne în câmpuri) / succes (redirect către /multumesc?kind=…). Fără JavaScript: butonul rămâne dezactivat
 * și apare <noscript> cu telefonul, emailul și linkul Calendly; nu există <form method="post"> către /api/lead.
 */
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Button from './Button.astro';
import { t, localePath, type Locale } from '../i18n';
import { site } from '../lib/site';

export interface FormLabels {
  title: string; intro?: string;
  name: string; company: string; employees?: string; employeesOptions?: string[]; phone: string; email: string;
  message: string; messagePlaceholder?: string; button: string;
}
interface Props { kind: 'radiografie' | 'contact'; lang: Locale; labels: FormLabels; id?: string; class?: string }
const { kind, lang, labels, id = 'formular', class: className } = Astro.props;
const dict = t(lang);
const f = (name: string) => `${kind}-${name}`;
const phoneRequired = kind === 'radiografie';
const messageRequired = kind === 'contact';
// „Completează [numele câmpului]…”: numele câmpului e eticheta, cu inițială mică, fără „(opțional)”
const fieldName = (label: string) => label.replace(/\s*\(.*\)\s*$/, '').replace(/^./, (c) => c.toLowerCase());
const messages = { emailInvalid: dict.form.emailInvalid, phoneInvalid: dict.form.phoneInvalid, sendError: dict.form.sendError, turnstileFailed: dict.form.turnstileFailed, sending: dict.form.sending, consentRequired: dict.form.required(fieldName(dict.consentCheckbox.fieldName)) };
const thankYou = localePath('thankYou', lang);
---
<div class:list={['form-wrap', className]} id={id} data-form-slot>
  <h2 class="form__title">{labels.title}</h2>
  {labels.intro && <p class="form__intro">{labels.intro}</p>}
  <form class="form" data-form={kind} data-lang={lang} data-thank-you={thankYou} data-sitekey={PUBLIC_TURNSTILE_SITE_KEY ?? ''} data-messages={JSON.stringify(messages)} novalidate>
    <div class="form__field">
      <label for={f('name')}>{labels.name} <span class="form__req" aria-hidden="true">*</span></label>
      <input id={f('name')} name="name" type="text" autocomplete="name" required data-msg-required={dict.form.required(fieldName(labels.name))} aria-describedby={f('name-error')} />
      <p class="form__error small" id={f('name-error')} hidden></p>
    </div>
    <div class="form__field">
      <label for={f('company')}>{labels.company} <span class="form__req" aria-hidden="true">*</span></label>
      <input id={f('company')} name="company" type="text" autocomplete="organization" required data-msg-required={dict.form.required(fieldName(labels.company))} aria-describedby={f('company-error')} />
      <p class="form__error small" id={f('company-error')} hidden></p>
    </div>
    {labels.employees && (
      <div class="form__field">
        <label for={f('employees')}>{labels.employees} <span class="form__req" aria-hidden="true">*</span></label>
        <select id={f('employees')} name="employees" required data-msg-required={dict.form.required(fieldName(labels.employees))} aria-describedby={f('employees-error')}>
          <option value=""></option>
          {(labels.employeesOptions ?? []).map((o) => <option value={o}>{o}</option>)}
        </select>
        <p class="form__error small" id={f('employees-error')} hidden></p>
      </div>
    )}
    <div class="form__row">
      <div class="form__field">
        <label for={f('phone')}>{labels.phone} {phoneRequired && <span class="form__req" aria-hidden="true">*</span>}</label>
        <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" required={phoneRequired} data-msg-required={dict.form.required(fieldName(labels.phone))} aria-describedby={f('phone-error')} />
        <p class="form__error small" id={f('phone-error')} hidden></p>
      </div>
      <div class="form__field">
        <label for={f('email')}>{labels.email} <span class="form__req" aria-hidden="true">*</span></label>
        <input id={f('email')} name="email" type="email" inputmode="email" autocomplete="email" required data-msg-required={dict.form.required(fieldName(labels.email))} aria-describedby={f('email-error')} />
        <p class="form__error small" id={f('email-error')} hidden></p>
      </div>
    </div>
    <div class="form__field">
      <label for={f('message')}>{labels.message} {messageRequired && <span class="form__req" aria-hidden="true">*</span>}</label>
      <textarea id={f('message')} name="message" rows="4" maxlength="5000" placeholder={labels.messagePlaceholder} required={messageRequired} data-msg-required={dict.form.required(fieldName(labels.message))} aria-describedby={f('message-error')}></textarea>
      <p class="form__error small" id={f('message-error')} hidden></p>
    </div>

    {/* Honeypot: container scos din ecran, nu display:none pe input */}
    <div class="form__hp" aria-hidden="true">
      <label for={f('website')}>Website</label>
      <input id={f('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form__field form__field--check">
      <input id={f('consent')} name="consent" type="checkbox" value="true" required aria-describedby={f('consent-error')} />
      <label for={f('consent')}>{dict.consentCheckbox.before}<a href={localePath('privacy', lang)}>{dict.consentCheckbox.linkLabel}</a>{dict.consentCheckbox.after} <span class="form__req" aria-hidden="true">*</span></label>
      <p class="form__error form__error--check small" id={f('consent-error')} hidden></p>
    </div>

    <div class="form__turnstile" data-turnstile></div>

    <Button type="submit" class="form__submit" data-event={`${kind}_submit`} disabled>{labels.button}</Button>
    <p class="form__status small" role="status" aria-live="polite" hidden></p>
    <p class="form__signature small muted">{dict.formSignature}</p>
    <noscript><p class="form__noscript small">{dict.form.noscript} <a href={site.calendly} target="_blank" rel="noopener" data-event="calendly_click">{dict.thankYou.radiografie.calendlyLabel}</a></p></noscript>
  </form>
</div>

<script>
  // Un singur script pentru toate formularele din pagină (pe /radiografie-it formularul e mutat în DOM sub 1024, dar rămâne o singură instanță).
  type Msgs = { emailInvalid: string; phoneInvalid: string; sendError: string; turnstileFailed: string; sending: string; consentRequired: string };
  declare global {
    interface Window { turnstile?: { render: (el: HTMLElement, o: Record<string, unknown>) => string; execute: (id: string) => void; reset: (id: string) => void }; bitupTurnstileReady?: () => void }
  }
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[data-form]'));
  // Scriptul Turnstile (~120 KB cu iframe-ul lui) se încarcă doar când cineva atinge formularul, ca pagina să rămână în bugetul de 300 KB
  // (ARHITECTURA § Performanță). Până atunci pagina nu face nicio cerere externă.
  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=bitupTurnstileReady&render=explicit';
  let loading: Promise<void> | null = null;
  const loadTurnstile = (): Promise<void> => {
    if (window.turnstile) return Promise.resolve();
    if (loading) return loading;
    loading = new Promise((resolve) => {
      window.bitupTurnstileReady = () => { renderWidgets(); resolve(); };
      const s = document.createElement('script');
      s.src = TURNSTILE_SRC; s.async = true; s.defer = true;
      s.onerror = () => resolve();
      document.head.appendChild(s);
    });
    return loading;
  };
  const widgets = new Map<HTMLFormElement, { id: string | null; token: string | null; executing: boolean; waiting: ((t: string | null) => void)[] }>();
  // execute() o singură dată per rundă (Turnstile avertizează la un al doilea execute pe un widget care rulează deja)
  const execute = (form: HTMLFormElement) => { const st = widgets.get(form)!; if (st.id && window.turnstile && !st.token && !st.executing) { st.executing = true; window.turnstile.execute(st.id); } };

  const renderWidgets = () => {
    for (const form of forms) {
      const slot = form.querySelector<HTMLElement>('[data-turnstile]');
      const key = form.dataset.sitekey;
      const state = widgets.get(form)!;
      if (!slot || !key || !window.turnstile || state.id) continue;
      state.id = window.turnstile.render(slot, {
        sitekey: key,
        appearance: 'interaction-only',
        execution: 'execute',
        callback: (token: string) => { state.token = token; state.executing = false; state.waiting.splice(0).forEach((r) => r(token)); },
        // tokenul rămâne în `state.token` și când nimeni nu-l mai așteaptă (a doua încercare îl folosește)
        'error-callback': () => { state.token = null; state.executing = false; state.waiting.splice(0).forEach((r) => r(null)); },
        'expired-callback': () => { state.token = null; state.executing = false; },
      });
    }
  };

  // Tokenul Turnstile, cu așteptare limitată (decizia din 4a→4b): dacă omul a completat repede și scriptul încă se încarcă, butonul stă în
  // „Se trimite…” cel mult `maxWait` ms; dacă tokenul nu vine, trimitem oricum și lasă funcția să decidă (răspunde 400 turnstile → mesajul de anti-spam,
  // textul rămâne, butonul se reactivează). Tokenul sosit după termen se păstrează pentru a doua încercare.
  const getToken = (form: HTMLFormElement, maxWait: number): Promise<string | null> => {
    const state = widgets.get(form)!;
    if (state.token) return Promise.resolve(state.token);
    return new Promise((resolve) => {
      const timer = setTimeout(() => resolve(null), maxWait);
      state.waiting.push((t) => { clearTimeout(timer); resolve(t); });
      loadTurnstile().then(() => execute(form));
    });
  };

  const setError = (field: HTMLElement, msg: string | null) => {
    const box = document.getElementById(field.getAttribute('aria-describedby') ?? '');
    if (msg) { field.setAttribute('aria-invalid', 'true'); if (box) { box.textContent = msg; box.hidden = false; } }
    else { field.removeAttribute('aria-invalid'); if (box) { box.textContent = ''; box.hidden = true; } }
  };

  const validate = (form: HTMLFormElement, msgs: Msgs): HTMLElement | null => {
    let first: HTMLElement | null = null;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input:not([type="hidden"]):not([name="website"]), select, textarea'));
    for (const el of fields) {
      let msg: string | null = null;
      const v = el.value.trim();
      if (el instanceof HTMLInputElement && el.type === 'checkbox') { if (el.required && !el.checked) msg = msgs.consentRequired; }
      else if (el.required && !v) msg = el.dataset.msgRequired ?? '';
      else if (el.getAttribute('type') === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) msg = msgs.emailInvalid;
      else if (el.getAttribute('type') === 'tel' && v && v.replace(/\D/g, '').length < 9) msg = msgs.phoneInvalid;
      setError(el, msg);
      if (msg && !first) first = el;
    }
    return first;
  };

  for (const form of forms) {
    widgets.set(form, { id: null, token: null, executing: false, waiting: [] });
    const msgs = JSON.parse(form.dataset.messages ?? '{}') as Msgs;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const label = submit.textContent ?? '';
    submit.disabled = false; // fără JavaScript rămâne dezactivat; <noscript> explică
    form.addEventListener('focusin', () => { loadTurnstile().then(() => execute(form)); }, { once: true });

    // eroarea de sub câmp dispare când omul corectează
    form.addEventListener('input', (e) => { const el = e.target as HTMLElement; if (el.getAttribute('aria-invalid')) setError(el, null); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      const firstBad = validate(form, msgs);
      if (firstBad) { firstBad.focus(); return; }

      submit.disabled = true;
      submit.textContent = msgs.sending;
      const fail = (msg: string) => { status.textContent = msg; status.hidden = false; submit.disabled = false; submit.textContent = label; };

      const token = (await getToken(form, 5000)) ?? '';

      const data = new FormData(form);
      const url = new URL(location.href);
      const payload = {
        kind: form.dataset.form, lang: form.dataset.lang,
        name: data.get('name'), company: data.get('company'), employees: data.get('employees') ?? '', phone: data.get('phone') ?? '', email: data.get('email'), message: data.get('message') ?? '',
        consent: data.get('consent') === 'true',
        source: url.pathname,
        utm: { source: url.searchParams.get('utm_source') ?? '', medium: url.searchParams.get('utm_medium') ?? '', campaign: url.searchParams.get('utm_campaign') ?? '', content: url.searchParams.get('utm_content') ?? '' },
        referrer: document.referrer,
        turnstileToken: token,
        website: data.get('website') ?? '',
        ts: new Date().toISOString(),
      };

      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 10000);
      try {
        const res = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), signal: ctrl.signal });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok === true) { location.assign(`${form.dataset.thankYou}?kind=${form.dataset.form}`); return; }
        const st = widgets.get(form)!; st.token = null; st.executing = false;
        if (window.turnstile && st.id) window.turnstile.reset(st.id);
        fail(body.error === 'turnstile' ? msgs.turnstileFailed : msgs.sendError);
      } catch {
        fail(msgs.sendError);
      } finally {
        clearTimeout(timer);
      }
    });
  }
</script>

<style>
  .form-wrap { background: var(--surface-2); border-radius: var(--r-card); padding: var(--s-5); display: grid; gap: var(--s-3); }
  @media (min-width: 768px) { .form-wrap { padding: var(--s-6); } }
  .form__title { font-size: var(--fs-h3); }
  .form__intro { color: var(--muted); }
  .form { display: grid; gap: var(--s-4); margin-top: var(--s-2); }
  .form__row { display: grid; gap: var(--s-4); }
  @media (min-width: 480px) { .form__row { grid-template-columns: 1fr 1fr; } }
  .form__field { display: grid; gap: var(--s-2); }
  .form__field label { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-small); color: var(--navy); }
  .form__req { color: var(--teal); }
  .form input:not([type="checkbox"]), .form select, .form textarea { width: 100%; padding: var(--s-3); border: 1px solid var(--line); border-radius: var(--r-field); background: var(--bg); color: var(--text); font-size: var(--fs-body); min-height: 44px; }
  .form select { appearance: auto; }
  .form textarea { resize: vertical; }
  .form input:focus-visible, .form select:focus-visible, .form textarea:focus-visible { outline: 2px solid var(--teal); outline-offset: 0; border-color: var(--teal); }
  .form input[aria-invalid="true"], .form textarea[aria-invalid="true"], .form select[aria-invalid="true"] { border-color: var(--crit); }
  .form__error { color: var(--crit); }
  .form__error[hidden] { display: none; }
  .form__hp { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .form__field--check { grid-template-columns: auto 1fr; align-items: start; }
  .form__field--check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--teal); }
  .form__field--check label { font-family: var(--font-body); font-weight: 400; font-size: var(--fs-small); color: var(--text); }
  .form__error--check { grid-column: 1 / -1; }
  .form__turnstile:empty { display: none; }
  .form :global(.form__submit) { width: 100%; }
  @media (min-width: 768px) { .form :global(.form__submit) { width: auto; justify-self: start; } }
  .form :global(.form__submit[disabled]) { opacity: .7; cursor: default; }
  .form__status { color: var(--crit); padding: var(--s-3); border: 1px solid var(--crit); border-radius: var(--r-field); }
  .form__status[hidden] { display: none; }
  .form__signature { margin-top: calc(var(--s-2) * -1); }
</style>
