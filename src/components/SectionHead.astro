---
/** Capul unei secțiuni: eyebrow + h2 (+ lead opțional), aliniate la stânga, niciodată centrate. */
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow: string; title: string; id?: string; lead?: string; class?: string }
const { eyebrow, title, id, lead, class: className } = Astro.props;
---
<div class:list={['shead', className]}>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h2 id={id} class="shead__title">{title}</h2>
  {lead && <p class="lead shead__lead">{lead}</p>}
</div>

<style>
  .shead { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
  .shead__title { max-width: 26ch; }
  .shead__lead { max-width: 60ch; }
</style>
