---
/**
 * Hero pentru paginile interne (DESIGN § Hero (pagini interne)): o coloană, pe --surface-2: eyebrow, h1, lead; opțional un buton și un rând --muted.
 * Fără imagine (excepțiile, Despre și studiile de caz, au hero-ul lor).
 */
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
interface Props { eyebrow: string; h1: string; lead?: string; button?: { label: string; href: string; event?: string }; note?: string; narrow?: boolean }
const { eyebrow, h1, lead, button, note, narrow = false } = Astro.props;
---
<section class="hero-int">
  <Container narrow={narrow}>
    <div class="hero-int__inner">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 class="hero-int__h1">{h1}</h1>
      {lead && <p class="lead hero-int__lead">{lead}</p>}
      {button && (
        <div class="hero-int__actions">
          <Button href={button.href} data-event={button.event}>{button.label}</Button>
          {note && <p class="small muted hero-int__note">{note}</p>}
        </div>
      )}
      <slot />
    </div>
  </Container>
</section>

<style>
  .hero-int { background: var(--surface-2); padding-block: var(--section-y); }
  .hero-int__inner { display: grid; gap: var(--s-4); justify-items: start; }
  .hero-int__h1 { max-width: 22ch; }
  .hero-int__lead { max-width: 60ch; }
  .hero-int__actions { display: grid; gap: var(--s-3); margin-top: var(--s-2); justify-items: start; }
  .hero-int__note { max-width: 50ch; }
</style>
