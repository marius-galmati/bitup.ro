---
/**
 * Butoane (DESIGN.md § Butoane).
 * primary: orange, text navy (singurul loc cu orange; maximum trei pe pagină).
 * secondary: transparent, bordură 1.5 px teal, text teal.
 * tertiary: link cu săgeată.
 * teal: plin teal, text alb (doar /suport, butonul de WhatsApp).
 * Focus: outline 2 px teal, offset 2 px; pe orange, outline navy.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'teal';
  size?: 'normal' | 'small';
  type?: 'button' | 'submit';
  disabled?: boolean;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'normal', type = 'button', disabled = false, external = false, class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 'small' && 'btn--small', className].filter(Boolean).join(' ');
const externalAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

{href && !disabled ? (
  <a href={href} class={classes} {...externalAttrs} {...rest}><slot /></a>
) : (
  <button type={type} class={classes} disabled={disabled} {...rest}><slot /></button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 14px 22px;
    border-radius: var(--r-pill);
    border: 1.5px solid transparent;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    background: none;
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .btn--small { font-size: var(--fs-small); padding: 10px 16px; min-height: 40px; }
  @media (min-width: 1024px) { .btn { min-height: 0; } .btn--small { min-height: 0; } }

  .btn--primary { background: var(--orange); color: #00202E; border-color: var(--orange); }
  .btn--primary:hover { background: #E9891F; border-color: #E9891F; color: #00202E; }
  .btn--primary:active { background: #D97C17; border-color: #D97C17; }
  .btn--primary:focus-visible { outline: 2px solid #00202E; outline-offset: 2px; }

  .btn--secondary { background: transparent; color: var(--teal); border-color: var(--teal); font-weight: 600; }
  .btn--secondary:hover { background: var(--teal-soft); color: var(--teal); }
  .btn--secondary:active { border-color: var(--navy); color: var(--navy); }

  .btn--teal { background: var(--teal); color: #FFFFFF; border-color: var(--teal); }
  .btn--teal:hover { background: var(--navy-2); border-color: var(--navy-2); color: #FFFFFF; }
  :root[data-theme="dark"] .btn--teal { color: #00202E; }
  :root[data-theme="dark"] .btn--teal:hover { background: var(--teal-2); border-color: var(--teal-2); color: #00202E; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .btn--teal { color: #00202E; }
    :root:not([data-theme="light"]) .btn--teal:hover { background: var(--teal-2); border-color: var(--teal-2); color: #00202E; }
  }

  .btn--tertiary { padding: 0; min-height: 0; border: 0; border-radius: 0; color: var(--teal); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .btn--tertiary::after { content: '→'; font-family: var(--font-body); font-weight: 400; }
  .btn--tertiary:hover { color: var(--navy); }

  .btn:disabled, .btn[aria-disabled="true"] { opacity: .5; cursor: not-allowed; pointer-events: none; }
</style>
