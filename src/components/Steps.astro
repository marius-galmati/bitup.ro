---
/**
 * Pași (DESIGN § Steps): doar pentru secvențe reale. Cerc teal cu numărul, h3, text. Pe desktop în rând, pe mobil în coloană.
 * `variant="rail"` (aranjamentul din example.png, banda de proces): de la 1200 px cei patru pași stau pe un singur rând,
 * cercul urcă deasupra titlului, iar nodurile sunt legate de o linie de 1 px cu o săgeată mică între ele.
 */
interface Props { steps: { title: string; text: string }[]; class?: string; variant?: 'default' | 'rail' }
const { steps, class: className, variant = 'default' } = Astro.props;
---
<ol role="list" class:list={['steps', { 'steps--rail': variant === 'rail' }, className]}>
  {steps.map((s, i) => (
    <li class="step">
      <span class="step__num" aria-hidden="true">{i + 1}</span>
      <h3 class="step__title">{s.title}</h3>
      <p class="step__text">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-6) var(--s-5); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); counter-reset: step; }
  /* Varianta „rail”: o coloană, apoi 2×2, apoi patru pe un rând — fără treapta de 3+1 pe care o dă auto-fit. */
  .steps--rail { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .steps--rail { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .step { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: var(--s-3); row-gap: var(--s-2); align-items: start; align-content: start; }
  .step__num { grid-row: 1 / span 2; width: 56px; height: 56px; display: inline-flex; align-items: center; justify-content: center; flex: none; border-radius: var(--r-pill); background: var(--teal); color: #FFFFFF; font-family: var(--font-display); font-weight: 700; font-size: 28px; font-variant-numeric: tabular-nums; }
  :root[data-theme="dark"] .step__num { color: #00202E; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .step__num { color: #00202E; } }
  .step__title { font-size: var(--fs-h3); align-self: center; }
  .step__text { grid-column: 2; }

  /* Varianta „rail”: un singur rând, cerc deasupra titlului, noduri legate printr-o linie. */
  @media (min-width: 1200px) {
    .steps--rail { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5); }
    .steps--rail .step { position: relative; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto; row-gap: var(--s-3); align-content: start; }
    .steps--rail .step__num { grid-row: auto; justify-self: start; }
    .steps--rail .step__title { align-self: start; margin-top: var(--s-1); }
    .steps--rail .step__text { grid-column: 1; margin-top: calc(-1 * var(--s-1)); }
    /* Linia pornește din dreapta cercului și trece peste gap, până la cercul următor. După ultimul pas curge mai departe. */
    .steps--rail .step::after { content: ''; position: absolute; left: var(--s-6); right: calc(-1 * var(--s-5)); top: calc(var(--s-6) / 2); height: 1px; background: var(--line); }
    .steps--rail .step:last-child::after { right: 0; }
    /* Vârf de săgeată la ~85% din interval, doar între noduri. */
    .steps--rail .step:not(:last-child)::before { content: ''; position: absolute; left: 85%; top: calc(var(--s-6) / 2); width: 6px; height: 6px; border-top: 1px solid var(--teal); border-right: 1px solid var(--teal); transform: translate(-50%, -50%) rotate(45deg); }
  }
</style>
