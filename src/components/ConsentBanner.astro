---
/**
 * ConsentBanner (DESIGN § ConsentBanner, 00-global § Banner). Faza 1: doar vizual, ascuns implicit (logica vine în Faza 5).
 * position: fixed, jos; pe mobil toată lățimea, pe desktop casetă de 420 px în colțul dreapta-jos, la 24 px de margini.
 * Fundal --surface, bordură --line, --radius-lg, umbră (light) / bordură (dark). Două butoane identice: Accept · Refuz.
 */
import Button from './Button.astro';
import { t, localePath, type Locale } from '../i18n';
interface Props { lang: Locale; visible?: boolean; current?: 'accepted' | 'declined' }
const { lang, visible = false, current } = Astro.props;
const c = t(lang).consent;
---
<div class="consent" role="region" aria-label={c.regionLabel} tabindex="-1" data-consent-banner hidden={!visible}>
  <p class="consent__title">{c.title}</p>
  <p class="consent__text">{c.text} <a href={localePath('cookies', lang)}>{c.linkLabel}</a></p>
  <div class="consent__actions">
    <Button variant="secondary" size="small" data-consent="accept">{c.accept}</Button>
    <Button variant="secondary" size="small" data-consent="decline">{c.decline}</Button>
  </div>
  {current && <p class="consent__current small muted">{current === 'accepted' ? c.currentAccepted : c.currentDeclined}</p>}
</div>

<style>
  .consent { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: var(--s-5) 20px; background: var(--surface); border-top: 1px solid var(--line); box-shadow: var(--shadow); display: grid; gap: var(--s-3); }
  .consent[hidden] { display: none; }
  @media (min-width: 768px) { .consent { left: auto; right: 24px; bottom: 24px; width: 420px; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--s-5); } }
  .consent__title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-body); color: var(--navy); }
  .consent__text { font-size: var(--fs-small); color: var(--text); }
  .consent__actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin-top: var(--s-1); }
  .consent__actions :global(.btn) { width: 100%; }
  .consent__current { margin: 0; }
</style>
