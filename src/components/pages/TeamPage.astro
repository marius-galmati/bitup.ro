---
/**
 * /echipa, /en/team (16). Singura pagină cu date personale ale altor oameni, deci `noindex, nofollow`
 * și în afara sitemap-ului cât timp `[[ACORD_ECHIPA]]` e necompletat (spec/continut/16-echipa.md § Indexare).
 *
 * Layout cerut de Marius (18–19 septembrie 2026): NU un grid de patru carduri egale — textele au 186, 189, 130
 * și 120 de cuvinte, iar într-o grilă egală diferența se vede. Patru rânduri suprapuse, despărțite de o linie
 * de 1 px, fiecare cu fotografia pătrată de 240 px în stânga, aliniată sus, și textul în dreapta. Fără alternanță
 * stânga/dreapta. Pe mobil fotografia trece deasupra, la 160 px, aliniată la stânga.
 *
 * Fotografii: trei din patru au sosit pe 19 septembrie 2026. Cine n-are încă poză primește substituentul —
 * același pătrat, aceeași bordură, cu inițialele în fontul de titlu. Decizia lui Marius, la întrebare directă:
 * cele trei poze intră acum, Cristian rămâne pe inițiale până trimite poza (abatere asumată de la regula lui de layout 5).
 * Poza lui Cristian a sosit pe 16 octombrie 2026 (`Echipa/Cristian.png`, decupată pătrat la 960 px); acum toți patru au fotografie.
 *
 * Marca „in” a LinkedIn: `public/icons/linkedin.svg`, decupată din `LinkedIn_Logo.svg` trimis de Marius.
 * Rămâne în albastrul oficial #2867B3 în toate stările, cum cer regulile lor de brand; hover-ul se marchează
 * prin opacitate, nu prin culoare (decizie a lui Marius, 19 septembrie 2026). Fișier local, zero cereri externe.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import HeroInternal from '../HeroInternal.astro';
import CtaBand from '../CtaBand.astro';
import { localePath, absoluteUrl, type Locale } from '../../i18n';
import { profilePage, teamMember } from '../../lib/schema';
import type { TeamCopy } from '../../copy/team.ro';
import fotoMarius from '../../assets/foto-echipa/marius-galmati-960x960.jpg';
import fotoPetre from '../../assets/foto-echipa/petre-radu-catalin-400x400.jpg';
import fotoSamuel from '../../assets/foto-echipa/samuel-bota-960x960.jpg';
import fotoCristian from '../../assets/foto-echipa/cristian-boanca-960x960.jpg';

/** Cine are fotografie. Cine lipsește de aici primește substituentul cu inițiale. */
const FOTO = { marius: fotoMarius, petre: fotoPetre, samuel: fotoSamuel, cristian: fotoCristian } as const;

interface Props { lang: Locale; copy: TeamCopy }
const { lang, copy } = Astro.props;

const url = absoluteUrl(localePath('team', lang));
const jsonLd = [
  profilePage(lang, { name: copy.hero.h1, url }),
  ...copy.people.map((p, i) => teamMember({ name: p.name, jobTitle: p.role, linkedin: p.linkedin, isFounder: i === 0 })),
];
const peopleHeading = lang === 'ro' ? 'Oamenii' : 'The people';
---
<BaseLayout lang={lang} routeKey="team" title={copy.title} description={copy.description} jsonLd={jsonLd} noindex>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} />

  <Section tone="surface" labelledby="people-title">
    <Container>
      {/* Secțiunea nu are titlu vizibil (cerut: fără tiparul eyebrow + H2 + carduri).
          Titlul există doar pentru cititoarele de ecran, ca ierarhia să meargă h1 → h2 → h3. */}
      <h2 id="people-title" class="sr-only">{peopleHeading}</h2>
      <p class="team-intro">{copy.intro.text}</p>

      {copy.people.map((p) => (
        <article class="person">
          {FOTO[p.id as keyof typeof FOTO]
            ? <Picture src={FOTO[p.id as keyof typeof FOTO]} alt={p.photoAlt} width={240} height={240} densities={[1, 2]} formats={['avif', 'webp']} loading="lazy" decoding="async" class="person__photo" />
            : <div class="person__photo person__photo--gol" aria-hidden="true"><span class="person__initials">{p.initials}</span></div>}
          <div class="person__body">
            <h3 class="person__name">{p.name}</h3>
            <p class="person__role label">{p.role}</p>
            <p class="person__exp muted">{p.experience}</p>
            <div class="person__text">{p.paragraphs.map((t) => <p>{t}</p>)}</div>
            <p class="person__link">
              {p.linkedin
                ? <a href={p.linkedin} target="_blank" rel="noopener" aria-label={p.linkedinAriaLabel}><img src="/icons/linkedin.svg" alt="" width="20" height="20" aria-hidden="true" /></a>
                : <span class="muted">{p.linkedinPlaceholder}</span>}
            </p>
          </div>
        </article>
      ))}
    </Container>
  </Section>

  <Section tone="bg" labelledby="closing-title">
    <Container>
      <SectionHead id="closing-title" eyebrow={copy.closing.eyebrow} title={copy.closing.h2} />
      <div class="closing">{copy.closing.paragraphs.map((t) => <p>{t}</p>)}</div>
    </Container>
  </Section>

  <CtaBand lang={lang} title={copy.cta.title} text={copy.cta.text} button={copy.cta.button} />
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .team-intro { max-width: 70ch; text-wrap: pretty; }

  /* Patru rânduri suprapuse, despărțite de o linie de păr. Fără alternanță stânga/dreapta. */
  .person { display: grid; gap: var(--s-4); justify-items: start; padding-block: var(--s-6); border-top: 1px solid var(--line); }
  .person:first-of-type { margin-top: var(--s-6); }
  @media (min-width: 768px) {
    .person { grid-template-columns: 240px minmax(0, 1fr); gap: var(--s-6); align-items: start; padding-block: var(--s-7); }
  }
  @media (min-width: 1024px) { .person { column-gap: var(--s-7); } }

  /* Fotografie și substituent, aceeași casetă: pătrat, colț de 4 px, bordură de 1 px. Nu rotund. */
  .person :global(.person__photo) { width: 160px; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--line); border-radius: var(--r-media); }
  @media (min-width: 768px) { .person :global(.person__photo) { width: 240px; } }
  .person__photo--gol { display: grid; place-items: center; background: var(--surface-2); }
  .person__initials { font-family: var(--font-display); font-weight: 700; font-size: 72px; color: var(--navy); }

  .person__body { display: grid; gap: var(--s-2); max-width: 70ch; }
  .person__name { font-size: var(--fs-h3); }
  .person__role { font-size: var(--fs-small); color: var(--teal); }
  .person__exp { font-size: var(--fs-small); }
  .person__text { display: grid; gap: var(--s-4); margin-top: var(--s-3); }
  .person__text p { text-wrap: pretty; }

  /* Marca „in”, 20 px, dar zona de atingere 44 × 44, ca să fie utilizabilă pe telefon. */
  .person__link { margin-top: var(--s-3); }
  .person__link a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin-left: -12px; transition: opacity 150ms; }
  .person__link a:hover { opacity: .75; }
  .person__link :global(img) { display: block; width: 20px; height: 20px; }
  .person__link span { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--fs-small); }

  .closing { display: grid; gap: var(--s-4); max-width: 70ch; }
  .closing p { text-wrap: pretty; }

  @media (prefers-reduced-motion: reduce) { .person__link a { transition: none; } }
</style>
