---
/**
 * /blog, /en/blog (12): hero intern → lista din colecția `blog` (pubDate desc; draft-urile doar pe staging). Un singur articol: card pe lățimea întreagă cu heroImage în dreapta;
 * mai multe: grid de carduri fără imagini → Trei teme (carduri statice) → rândul de abonare (LinkedIn, RSS) → CtaBand varianta blog. JSON-LD: global. RSS în <head>.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Card from '../Card.astro';
import CtaBand from '../CtaBand.astro';
import { dynamicPath, formatDate, localePath, t, type Locale } from '../../i18n';
import { visiblePosts, slugOf, readMinutes } from '../../lib/collections';
import { site } from '../../lib/site';
import type { BlogCopy } from '../../copy/blog.ro';

interface Props { lang: Locale; copy: BlogCopy }
const { lang, copy } = Astro.props;
const dict = t(lang);
const posts = await visiblePosts(lang);
const single = posts.length === 1 ? posts[0] : null;
const rssPath = localePath('rss', lang);
---
<BaseLayout lang={lang} routeKey="blog" title={copy.title} description={copy.description} rss={rssPath}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} />

  <Section tone="bg">
    <Container>
      {single ? (
        <article class="post-wide">
          <div class="post-wide__text">
            <p class="eyebrow">{single.data.tags[0]}{single.data.draft && <span class="muted"> · {dict.misc.draft}</span>}</p>
            <h2 class="post-wide__title"><a href={dynamicPath('post', lang, slugOf(single.id))}>{single.data.title}</a></h2>
            <p>{single.data.description}</p>
            <p class="small muted tnum">{formatDate(single.data.pubDate, lang)} · {dict.misc.readTime(readMinutes(single.body))}</p>
          </div>
          {single.data.heroImage && (
            <Picture src={single.data.heroImage} alt="" widths={[360, 720]} sizes="(min-width: 1024px) 360px, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" class="post-wide__image" />
          )}
        </article>
      ) : (
        <div class="grid-3">
          {posts.map((p) => (
            <Card title={p.data.title} href={dynamicPath('post', lang, slugOf(p.id))} linkLabel={p.data.title}>
              <p class="eyebrow">{p.data.tags[0]}</p>
              <p>{p.data.description}</p>
              <p class="small muted tnum">{formatDate(p.data.pubDate, lang)} · {dict.misc.readTime(readMinutes(p.body))}</p>
            </Card>
          ))}
        </div>
      )}
    </Container>
  </Section>

  <Section tone="surface" labelledby="themes-title">
    <Container>
      <SectionHead id="themes-title" eyebrow={copy.themes.eyebrow} title={copy.themes.h2} />
      <div class="grid-3">{copy.themes.cards.map((c) => <Card title={c.title}><p>{c.text}</p></Card>)}</div>
    </Container>
  </Section>

  <Section tone="bg" line>
    <Container>
      <p class="muted subscribe">{copy.subscribe.before}<a href={site.linkedin} target="_blank" rel="noopener">{copy.subscribe.linkedin}</a>{copy.subscribe.middle}<a href={rssPath}>{copy.subscribe.rss}</a>{copy.subscribe.after}</p>
    </Container>
  </Section>

  <CtaBand lang={lang} variant="blog" />
</BaseLayout>

<style>
  .post-wide { display: grid; gap: var(--s-5); padding: var(--s-6); background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--teal); border-radius: var(--r-media); align-items: center; }
  @media (min-width: 768px) { .post-wide { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s-7); } }
  @media (min-width: 1024px) { .post-wide { grid-template-columns: minmax(0, 1fr) 360px; } }
  .post-wide__text { display: grid; gap: var(--s-3); }
  .post-wide__title { font-size: var(--fs-h2); }
  .post-wide__title a { color: var(--navy); text-decoration: none; }
  .post-wide__title a:hover { color: var(--teal); text-decoration: underline; text-underline-offset: 4px; }
  .post-wide :global(.post-wide__image) { width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--r-media); }
  .grid-3 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .subscribe { max-width: 70ch; }
  .subscribe a { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
</style>
