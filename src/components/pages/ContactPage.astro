---
/**
 * /contact, /en/contact (11). Fără CtaBand; formularul e acțiunea.
 * Ritm: hero → două coloane: stânga căile directe ca listă cu etichete mono, dreapta formularul (bg) → „Ce se întâmplă după” (două coloane, surface). JSON-LD: global.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import TwoCol from '../TwoCol.astro';
import Form from '../Form.astro';
import { localePath, type Locale } from '../../i18n';
import { site } from '../../lib/site';
import type { ContactCopy } from '../../copy/contact.ro';

interface Props { lang: Locale; copy: ContactCopy }
const { lang, copy } = Astro.props;
const w = copy.ways;
---
<BaseLayout lang={lang} routeKey="contact" title={copy.title} description={copy.description}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1}>
    <p class="lead contact-lead">{copy.hero.leadBefore}<a href={localePath('healthCheck', lang)}>{copy.hero.leadLink}</a>{copy.hero.leadAfter}</p>
  </HeroInternal>

  <Section tone="bg">
    <Container>
      <div class="contact">
        <dl class="ways">
          <div class="way"><dt class="way__k">{w.phone.label}</dt><dd class="way__v"><a class="mono" href={site.phone.href} data-event="tel_click">{site.phone.display}</a><span class="way__note">{w.phone.hours}</span></dd></div>
          <div class="way"><dt class="way__k">{w.email.label}</dt><dd class="way__v"><a class="mono" href={site.emailHref}>{site.email}</a><span class="way__note">{w.email.note}</span></dd></div>
          <div class="way"><dt class="way__k">{w.book.label}</dt><dd class="way__v"><a href={site.calendly} target="_blank" rel="noopener" data-event="calendly_click">{w.book.text}<span aria-hidden="true"> →</span></a></dd></div>
          <div class="way"><dt class="way__k">{w.clients.label}</dt><dd class="way__v"><a href={localePath('support', lang)}>{w.clients.text}<span aria-hidden="true"> →</span></a></dd></div>
          <div class="way"><dt class="way__k">{w.where.label}</dt><dd class="way__v">{w.where.value}</dd></div>
          <div class="way"><dt class="way__k">{w.company.label}</dt><dd class="way__v">{w.company.value}</dd></div>
          <div class="way"><dt class="way__k">{w.linkedin.label}</dt><dd class="way__v"><span><a href={site.founder.linkedin} target="_blank" rel="noopener">{w.linkedin.personal}<span aria-hidden="true"> →</span></a> · <a href={site.linkedin} target="_blank" rel="noopener">{w.linkedin.company}<span aria-hidden="true"> →</span></a></span></dd></div>
        </dl>
        <div class="contact__form">
          <Form kind="contact" lang={lang} labels={copy.form} id="formular" />
          <p class="small muted under">{copy.under.before} <a href={localePath('howWeWork', lang)}>{copy.under.link1}</a> · <a href={localePath('results', lang)}>{copy.under.link2}</a></p>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="surface" labelledby="after-title">
    <Container>
      <TwoCol id="after-title" eyebrow={copy.after.eyebrow} title={copy.after.h2}>
        <p>{copy.after.before}<a href={localePath('support', lang)}>{copy.after.link}</a>{copy.after.after}</p>
      </TwoCol>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact-lead { max-width: 60ch; }
  .contact-lead a { font-weight: 600; }
  .contact { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 1024px) { .contact { grid-template-columns: minmax(0, 1fr) 460px; gap: var(--s-8); } }
  .ways { margin: 0; display: grid; }
  .way { display: grid; gap: var(--s-1); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .way:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 480px) { .way { grid-template-columns: 160px 1fr; gap: var(--s-4); } }
  .way__k { font-family: var(--font-mono); font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); padding-top: 4px; }
  .way__v { margin: 0; display: grid; gap: var(--s-1); }
  .way__v a { font-weight: 600; }
  .way__note { font-size: var(--fs-small); color: var(--muted); }
  .contact__form { display: grid; gap: var(--s-4); }
  .under a { color: var(--muted); }
  .under a:hover { color: var(--teal); }
</style>
