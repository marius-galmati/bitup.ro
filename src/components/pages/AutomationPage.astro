---
/**
 * /servicii/automatizari, /en/services/automation (05).
 * Ritm: hero cu buton → Situația: listă cu marcaje + text (două coloane) → Cum lucrăm aici: patru pași în rând (surface) → Ce construim: trei carduri (bg)
 * → Dovada: text + captura WhatsApp (surface) → Software la comandă: text + caseta de logo ProQ pe navy (bg) → Onest: listă cu titluri (două coloane, surface-2)
 * → FAQ (două coloane) → CtaBand cu titlu înlocuit. JSON-LD: Service + FAQPage.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import TwoCol from '../TwoCol.astro';
import Card from '../Card.astro';
import Steps from '../Steps.astro';
import Figure from '../Figure.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { localePath, dynamicPath, anchors, absoluteUrl, routes, type Locale } from '../../i18n';
import { service } from '../../lib/schema';
import type { AutomationCopy } from '../../copy/automation.ro';
import whatsapp from '../../assets/blog/helpdesk/whatsapp-cipri.jpg';
import { existsSync } from 'node:fs';

interface Props { lang: Locale; copy: AutomationCopy }
const { lang, copy } = Astro.props;
const a = anchors.automation[lang];
// Caseta ProQ: logo-ul local (varianta pentru fundal închis) dacă e salvat, altfel placeholder-ul vizibil (CLAUDE.md regula 3).
const proqLogo = existsSync('public/logos/proq.svg') ? '/logos/proq.svg' : null;
const jsonLd = [service(lang, copy.serviceName, copy.description, absoluteUrl(routes.automation[lang]))];
---
<BaseLayout lang={lang} routeKey="automation" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} button={{ label: copy.hero.button, href: localePath('healthCheck', lang), event: 'cta_radiografie_click' }} />

  <Section tone="bg" labelledby="situation-title">
    <Container>
      <TwoCol id="situation-title" eyebrow={copy.situation.eyebrow} title={copy.situation.h2}>
        <ul class="marks">{copy.situation.items.map((it) => <li>{it}</li>)}</ul>
        <p class="after">{copy.situation.text}</p>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="how-title">
    <Container>
      <SectionHead id="how-title" eyebrow={copy.how.eyebrow} title={copy.how.h2} />
      <Steps steps={copy.how.steps} />
    </Container>
  </Section>

  <Section tone="bg" labelledby="build-title">
    <Container>
      <SectionHead id="build-title" eyebrow={copy.build.eyebrow} title={copy.build.h2} />
      <div class="grid-3">
        {copy.build.cards.map((c) => (
          c.anchor
            ? <Card title={c.title} href={`#${a.software}`} linkLabel={copy.software.h2.split(':')[0]}><p>{c.text}</p></Card>
            : <Card title={c.title}><p>{c.text}</p></Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="surface" labelledby="proof-title">
    <Container>
      <SectionHead id="proof-title" eyebrow={copy.proof.eyebrow} title={copy.proof.h2} />
      <div class="split">
        <div class="stack">
          <p>{copy.proof.p1}</p>
          <p>{copy.proof.p2} <a href={copy.proof.linkPath}>{copy.proof.link}<span aria-hidden="true"> →</span></a></p>
        </div>
        <Figure kind="screenshot" class="split__figure">
          <Picture src={whatsapp} alt={copy.proof.imageAlt} widths={[360, 720]} sizes="(min-width: 1024px) 360px, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </Figure>
      </div>
    </Container>
  </Section>

  <Section tone="bg" id={a.software} labelledby="software-title">
    <Container>
      <SectionHead id="software-title" eyebrow={copy.software.eyebrow} title={copy.software.h2} />
      <div class="split">
        <div class="stack">
          <p>{copy.software.p1}</p>
          <p>{copy.software.p2} <a href={dynamicPath('caseStudy', lang, 'proq')}>{copy.software.caseLink}<span aria-hidden="true"> →</span></a></p>
          <p>{copy.software.p3}</p>
          <p>{copy.software.p4}</p>
        </div>
        <div class="logo-box" aria-hidden="true">{proqLogo ? <img src={proqLogo} alt="" width="220" height="64" loading="lazy" decoding="async" /> : <span>[[LOGO_PROQ_LOCAL]]</span>}</div>
      </div>
    </Container>
  </Section>

  <Section tone="surface-2" labelledby="honest-title">
    <Container>
      <TwoCol id="honest-title" eyebrow={copy.honest.eyebrow} title={copy.honest.h2}>
        <ul class="marks marks--titled">
          {copy.honest.items.map((it) => <li><strong class="marks__title">{it.title}</strong> <span>{it.text}</span></li>)}
        </ul>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" id={a.faq} labelledby="faq-title">
    <Container>
      <TwoCol id="faq-title" eyebrow={copy.faq.h2} title={copy.faq.h2}>
        <Faq items={copy.faq.items} lang={lang} />
      </TwoCol>
    </Container>
  </Section>

  <CtaBand lang={lang} title={copy.cta.title} text={copy.cta.text} button={copy.cta.button} />
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--s-4); max-width: 70ch; }
  .stack a, .after a { font-family: var(--font-display); font-weight: 600; }
  .marks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .marks li { position: relative; padding-left: var(--s-5); }
  .marks li::before { content: ''; position: absolute; left: 0; top: .6em; width: var(--s-3); height: 3px; background: var(--teal); }
  .marks__title { font-family: var(--font-display); font-weight: 600; color: var(--navy); }
  .after { margin-top: var(--s-5); }
  .grid-3 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .split { display: grid; gap: var(--s-6); align-items: start; }
  .split :global(.split__figure) { max-width: 360px; }
  @media (min-width: 1024px) { .split { grid-template-columns: minmax(0, 1fr) 360px; gap: var(--s-8); } }
  .logo-box { display: grid; place-items: center; min-height: 200px; padding: var(--s-6); background: var(--navy-surface); border: 1px solid var(--line); border-radius: var(--r-media); color: var(--on-navy-muted); font-size: var(--fs-small); }
  .logo-box img { max-width: 100%; height: auto; }
</style>
