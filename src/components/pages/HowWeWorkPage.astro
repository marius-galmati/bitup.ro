---
/**
 * /cum-lucram, /en/how-we-work (07).
 * Ritm: hero → diagrama celor patru pași (SVG inline, pe surface) → pașii 1–4 în modelul două coloane, alternând bg/surface, pasul 3 ca listă
 * → Cum ceri ajutor: patru pași + captura WhatsApp (surface-2) → Raportul lunar: text + placeholder (bg) → Incidente / Bani / Ieșirea, două coloane (surface, bg, surface)
 * → Întrebări (două coloane, bg) → CtaBand. JSON-LD: global + FAQPage.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import TwoCol from '../TwoCol.astro';
import Figure from '../Figure.astro';
import Placeholder from '../Placeholder.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import ProcessDiagram from '../ProcessDiagram.astro';
import { localePath, anchors, type Locale } from '../../i18n';
import type { HowWeWorkCopy } from '../../copy/howwework.ro';
import whatsapp from '../../assets/blog/helpdesk/whatsapp-cipri.jpg';

interface Props { lang: Locale; copy: HowWeWorkCopy }
const { lang, copy } = Astro.props;
---
<BaseLayout lang={lang} routeKey="howWeWork" title={copy.title} description={copy.description}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} />

  <Section tone="surface" labelledby="overview-title">
    <Container>
      <SectionHead id="overview-title" eyebrow={copy.overview.eyebrow} title={copy.overview.h2} />
      <ProcessDiagram nodes={copy.overview.nodes} />
    </Container>
  </Section>

  <Section tone="bg" labelledby="s1-title">
    <Container>
      <TwoCol id="s1-title" eyebrow={copy.step1.eyebrow} title={copy.step1.h2}>
        <p>{copy.step1.text} <a href={localePath('healthCheck', lang)}>{copy.step1.link}<span aria-hidden="true"> →</span></a></p>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="s2-title">
    <Container>
      <TwoCol id="s2-title" eyebrow={copy.step2.eyebrow} title={copy.step2.h2}><p>{copy.step2.text}</p></TwoCol>
    </Container>
  </Section>

  <Section tone="bg" labelledby="s3-title">
    <Container>
      <TwoCol id="s3-title" eyebrow={copy.step3.eyebrow} title={copy.step3.h2}>
        <ul class="marks">
          {copy.step3.items.map((it) => <li><strong class="marks__title">{it.title}</strong>{it.text.startsWith(',') ? it.text : ` ${it.text}`}</li>)}
        </ul>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="s4-title">
    <Container>
      <TwoCol id="s4-title" eyebrow={copy.step4.eyebrow} title={copy.step4.h2}><p>{copy.step4.text}</p></TwoCol>
    </Container>
  </Section>

  <Section tone="surface-2" labelledby="help-title">
    <Container>
      <SectionHead id="help-title" eyebrow={copy.help.eyebrow} title={copy.help.h2} />
      <div class="help">
        <div class="help__text">
          <ol class="help__steps">
            {copy.help.steps.map((s, i) => <li class="help__step"><span class="help__num tnum" aria-hidden="true">{i + 1}.</span><span>{s}</span></li>)}
          </ol>
          <p class="help__row">{copy.help.row} <a href={copy.help.linkPath}>{copy.help.link}<span aria-hidden="true"> →</span></a></p>
        </div>
        <Figure kind="screenshot" class="help__figure">
          <Picture src={whatsapp} alt={copy.help.imageAlt} widths={[360, 720]} sizes="(min-width: 1024px) 360px, 90vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </Figure>
      </div>
    </Container>
  </Section>

  <Section tone="bg" labelledby="report-title">
    <Container>
      <SectionHead id="report-title" eyebrow={copy.report.eyebrow} title={copy.report.h2} />
      <div class="report">
        <p class="report__text">{copy.report.text}</p>
        <Placeholder name="[[CAPTURA_RAPORT_LUNAR]]" ratio="3 / 4" class="report__figure" />
      </div>
    </Container>
  </Section>

  <Section tone="surface" labelledby="incidents-title">
    <Container>
      <TwoCol id="incidents-title" eyebrow={copy.incidents.eyebrow} title={copy.incidents.h2}>
        <p>{copy.incidents.text} <a href={localePath('security', lang, anchors.security[lang].incidents)}>{copy.incidents.link}<span aria-hidden="true"> →</span></a></p>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" labelledby="billing-title">
    <Container>
      <TwoCol id="billing-title" eyebrow={copy.billing.eyebrow} title={copy.billing.h2}><p>{copy.billing.text}</p></TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="exit-title">
    <Container>
      <TwoCol id="exit-title" eyebrow={copy.exit.eyebrow} title={copy.exit.h2}><p>{copy.exit.text}</p></TwoCol>
    </Container>
  </Section>

  <Section tone="bg" labelledby="faq-title">
    <Container>
      <TwoCol id="faq-title" eyebrow={copy.faq.h2} title={copy.faq.h2}>
        <Faq items={copy.faq.items} lang={lang} />
      </TwoCol>
    </Container>
  </Section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  p a, .help__row a { font-family: var(--font-display); font-weight: 600; }
  .marks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .marks li { position: relative; padding-left: var(--s-5); }
  .marks li::before { content: ''; position: absolute; left: 0; top: .6em; width: var(--s-3); height: 3px; background: var(--teal); }
  .marks__title { font-family: var(--font-display); font-weight: 600; color: var(--navy); }
  .help { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 1024px) { .help { grid-template-columns: minmax(0, 1fr) 360px; gap: var(--s-8); } }
  .help__text { display: grid; gap: var(--s-5); max-width: 70ch; }
  .help__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .help__step { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); }
  .help__num { color: var(--teal); font-weight: 500; }
  .help :global(.help__figure) { max-width: 360px; }
  .report { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 1024px) { .report { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--s-8); } }
  .report__text { max-width: 70ch; }
</style>
