---
/**
 * /servicii, /en/services (02). Ritm: hero intern → trei grupuri ca benzi late (titlu + poziționare stânga, include/pentru/link dreapta), NU grid de carduri
 * → „Cum se combină” în două coloane → „Ce nu facem” listă cu marcaje → CtaBand. JSON-LD: doar global.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import TwoCol from '../TwoCol.astro';
import CtaBand from '../CtaBand.astro';
import { localePath, type Locale } from '../../i18n';
import type { ServicesCopy } from '../../copy/services.ro';

interface Props { lang: Locale; copy: ServicesCopy }
const { lang, copy } = Astro.props;
---
<BaseLayout lang={lang} routeKey="services" title={copy.title} description={copy.description}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} />

  <Section tone="bg">
    <Container>
      <ol class="groups">
        {copy.groups.map((g, i) => (
          <li class="group">
            <div class="group__head">
              <span class="small muted group__num tnum" aria-hidden="true">0{i + 1}</span>
              <h2 class="group__title">{g.title}</h2>
              <p class="group__position">{g.position}</p>
            </div>
            <div class="group__body">
              <p><strong class="group__label">{g.includesLabel}</strong> {g.includes}</p>
              <p><strong class="group__label">{g.forLabel}</strong> {g.forWho}</p>
              <p class="group__link"><a href={localePath(g.route, lang)}>{g.link}<span aria-hidden="true"> →</span></a></p>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="combine-title">
    <Container>
      <TwoCol id="combine-title" eyebrow={copy.combine.eyebrow} title={copy.combine.h2}>
        <div class="prose-like">{copy.combine.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" labelledby="not-title">
    <Container>
      <TwoCol id="not-title" eyebrow={copy.not.eyebrow} title={copy.not.h2}>
        <ul class="marks">{copy.not.items.map((it) => <li>{it}</li>)}</ul>
      </TwoCol>
    </Container>
  </Section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .groups { list-style: none; margin: 0; padding: 0; display: grid; }
  .group { display: grid; gap: var(--s-4); padding-block: var(--s-6); border-top: 1px solid var(--line); }
  .group:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 1024px) { .group { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); padding-block: var(--s-7); } }
  .group__head { display: grid; gap: var(--s-3); align-content: start; }
  .group__num { font-variant-numeric: tabular-nums; }
  .group__title { font-size: var(--fs-h2); max-width: 16ch; }
  .group__position { font-size: var(--fs-lead); color: var(--muted); max-width: 40ch; }
  .group__body { display: grid; gap: var(--s-3); max-width: 70ch; align-content: start; }
  .group__label { font-family: var(--font-display); font-weight: 600; color: var(--navy); }
  .group__link a { font-family: var(--font-display); font-weight: 600; }
  .prose-like { display: grid; gap: var(--s-4); }
  .marks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .marks li { position: relative; padding-left: var(--s-5); }
  .marks li::before { content: ''; position: absolute; left: 0; top: .6em; width: var(--s-3); height: 3px; background: var(--teal); }
</style>
