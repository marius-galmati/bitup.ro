---
/**
 * /despre, /en/about (09). Pagina firmei, nu a fondatorului: fără portret și fără nicio imagine (rescrisă pe 18 septembrie 2026).
 * Ritm deliberat diferit de la o secțiune la alta, ca să nu cadă în mirosul #10:
 *   hero tipografic (surface-2) → Originea: două coloane cu eyebrow sticky (bg) → Echipa: titlu lat, două coloane de text, link sub linie (surface)
 *   → Cui ne adresăm: o singură coloană, listă cu buline (bg) → Ce rezolvăm: patru carduri 2×2 (surface-2)
 *   → Tehnologia: o coloană, primul paragraf la --fs-lead, link sub linie (bg) → Valorile: trei carduri (bg, cu linie deasupra)
 *   → Datele firmei: FactStrip + link (surface) → CtaBand cu titlul înlocuit.
 * JSON-LD: global + AboutPage cu `mainEntity` → Organization. Fondatorul rămâne în graf prin `Organization.founder`; nod Person separat doar pe /echipa.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import HeroInternal from '../HeroInternal.astro';
import TwoCol from '../TwoCol.astro';
import Eyebrow from '../Eyebrow.astro';
import Card from '../Card.astro';
import FactStrip from '../FactStrip.astro';
import CtaBand from '../CtaBand.astro';
import { dynamicPath, localePath, absoluteUrl, type Locale } from '../../i18n';
import { aboutPage } from '../../lib/schema';
import { site } from '../../lib/site';
import type { AboutCopy } from '../../copy/about.ro';

interface Props { lang: Locale; copy: AboutCopy }
const { lang, copy } = Astro.props;
const jsonLd = [aboutPage(lang, { name: copy.hero.h1, description: copy.description, url: absoluteUrl(localePath('about', lang)) })];
---
<BaseLayout lang={lang} routeKey="about" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} />

  <Section tone="bg" labelledby="origin-title">
    <Container>
      <TwoCol id="origin-title" eyebrow={copy.origin.eyebrow} title={copy.origin.h2}>
        <div class="stack">{copy.origin.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="team-title">
    <Container>
      <div class="team">
        <Eyebrow>{copy.team.eyebrow}</Eyebrow>
        <h2 id="team-title" class="team__h2">{copy.team.h2}</h2>
        <div class="team__cols">{copy.team.paragraphs.map((p) => <p>{p}</p>)}</div>
        <p class="team__link"><a href={localePath('team', lang)}>{copy.team.link}<span aria-hidden="true"> →</span></a></p>
      </div>
    </Container>
  </Section>

  <Section tone="bg" labelledby="audience-title">
    <Container>
      <SectionHead id="audience-title" eyebrow={copy.audience.eyebrow} title={copy.audience.h2} />
      <ul class="who">{copy.audience.items.map((it) => <li>{it}</li>)}</ul>
      <p class="who__closing muted">{copy.audience.closing}</p>
    </Container>
  </Section>

  <Section tone="surface-2" labelledby="problems-title">
    <Container>
      <SectionHead id="problems-title" eyebrow={copy.problems.eyebrow} title={copy.problems.h2} />
      <div class="grid-2">{copy.problems.cards.map((c) => <Card title={c.title}><p>{c.text}</p></Card>)}</div>
    </Container>
  </Section>

  <Section tone="bg" labelledby="tech-title">
    <Container>
      <SectionHead id="tech-title" eyebrow={copy.tech.eyebrow} title={copy.tech.h2} />
      <div class="tech">
        <p class="tech__lead">{copy.tech.paragraphs[0]}</p>
        <p>{copy.tech.paragraphs[1]}</p>
        <p class="tech__link"><a href={dynamicPath('caseStudy', lang, 'proq')}>{copy.tech.link}<span aria-hidden="true"> →</span></a></p>
      </div>
    </Container>
  </Section>

  <Section tone="bg" line labelledby="values-title">
    <Container>
      <SectionHead id="values-title" eyebrow={copy.values.eyebrow} title={copy.values.h2} />
      <div class="grid-3">{copy.values.cards.map((c) => <Card title={c.title}><p>{c.text}</p></Card>)}</div>
    </Container>
  </Section>

  <Section tone="surface" labelledby="company-title">
    <Container>
      <SectionHead id="company-title" eyebrow={copy.company.eyebrow} title={copy.company.h2} />
      <FactStrip items={copy.company.facts} />
      <p class="company-link">
        <a href={site.linkedin} target="_blank" rel="noopener">{copy.company.companyLink}<span aria-hidden="true"> →</span></a>
      </p>
    </Container>
  </Section>

  <CtaBand lang={lang} title={copy.cta.title} text={copy.cta.text} button={copy.cta.button} />
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--s-4); }

  /* Echipa: titlul ocupă toată lățimea, cele două paragrafe stau alături; linkul e despărțit de o linie de păr. */
  .team { display: grid; gap: var(--s-3); }
  .team__h2 { max-width: 30ch; }
  .team__cols { display: grid; gap: var(--s-4); margin-top: var(--s-3); }
  .team__cols p { max-width: 62ch; }
  @media (min-width: 1024px) { .team__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-8); } }
  .team__link { margin-top: var(--s-4); padding-top: var(--s-5); border-top: 1px solid var(--line); }

  /* Cui ne adresăm: secțiunea liniștită a paginii — o singură coloană, buline simple, fără carduri. */
  .who { margin: 0; padding-left: var(--s-5); max-width: 70ch; display: grid; gap: var(--s-3); }
  .who li { text-wrap: pretty; }
  .who li::marker { color: var(--teal); }
  .who__closing { margin-top: var(--s-6); max-width: 60ch; }

  .grid-2 { display: grid; gap: var(--s-5); }
  @media (min-width: 768px) { .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .grid-3 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }

  .tech { display: grid; gap: var(--s-4); max-width: 70ch; }
  .tech__lead { font-size: var(--fs-lead); }
  .tech__link { margin-top: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--line); }

  .company-link { margin-top: var(--s-5); }

  .team__link a, .tech__link a, .company-link a { font-family: var(--font-display); font-weight: 600; color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .team__link a:hover, .tech__link a:hover, .company-link a:hover { color: var(--navy); }
</style>
