---
/**
 * /servicii/suport-it, /en/services/it-support (03).
 * Ritm: hero cu buton → Situația (două coloane, text) → Ce include (două liste una lângă alta, pe surface) → Trei formule (3 carduri, singurul grid)
 * → Cloud (două coloane) → Echipamente (două coloane, surface) → O lună tipică (text + Figure placeholder) → Potrivire (două liste, surface-2)
 * → FAQ (două coloane) → CtaBand. JSON-LD: Service + FAQPage.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import TwoCol from '../TwoCol.astro';
import Card from '../Card.astro';
import Faq from '../Faq.astro';
import Placeholder from '../Placeholder.astro';
import CtaBand from '../CtaBand.astro';
import { localePath, dynamicPath, anchors, absoluteUrl, routes, type Locale } from '../../i18n';
import { service } from '../../lib/schema';
import { isProduction } from '../../lib/env';
import type { ItSupportCopy } from '../../copy/itsupport.ro';

interface Props { lang: Locale; copy: ItSupportCopy }
const { lang, copy } = Astro.props;
const a = anchors.itSupport[lang];
const cosmio = (await getCollection('cases', (e) => e.id === `${lang}/cosmio`))[0];
// Regula (Faza 2b, decizia lui Marius): când studiul de caz e draft sau lipsește, propoziția care îl linkuiește nu se randează deloc, pe nicio pagină.
const showCosmio = !!cosmio && (!cosmio.data.draft || !isProduction);
const jsonLd = [service(lang, copy.serviceName, copy.description, absoluteUrl(routes.itSupport[lang]))];
---
<BaseLayout lang={lang} routeKey="itSupport" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} button={{ label: copy.hero.button, href: localePath('healthCheck', lang), event: 'cta_radiografie_click' }} note={copy.hero.note} />

  <Section tone="bg" labelledby="situation-title">
    <Container>
      <TwoCol id="situation-title" eyebrow={copy.situation.eyebrow} title={copy.situation.h2}>
        <div class="stack">{copy.situation.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" id={a.included} labelledby="included-title">
    <Container>
      <SectionHead id="included-title" eyebrow={copy.included.eyebrow} title={copy.included.h2} />
      <div class="lists">
        <div class="lists__col">
          <h3 class="lists__title">{copy.included.weTitle}</h3>
          <ul class="marks">{copy.included.we.map((it) => <li>{it}</li>)}</ul>
        </div>
        <div class="lists__col lists__col--you">
          <h3 class="lists__title">{copy.included.youTitle}</h3>
          <ul class="marks">{copy.included.you.map((it) => <li>{it}</li>)}</ul>
        </div>
      </div>
      <p class="row-note small muted">{copy.included.row}</p>
    </Container>
  </Section>

  <Section tone="bg" labelledby="options-title">
    <Container>
      <SectionHead id="options-title" eyebrow={copy.options.eyebrow} title={copy.options.h2} />
      <div class="grid-3">{copy.options.cards.map((c) => <Card title={c.title}><p>{c.text}</p></Card>)}</div>
    </Container>
  </Section>

  <Section tone="surface" id={a.cloud} labelledby="cloud-title">
    <Container>
      <TwoCol id="cloud-title" eyebrow={copy.cloud.eyebrow} title={copy.cloud.h2}>
        <div class="stack">
          {copy.cloud.paragraphs.map((p) => <p>{p}</p>)}
          {showCosmio && <p>{copy.cloud.example} <a href={dynamicPath('caseStudy', lang, 'cosmio')}>{copy.cloud.caseLink}<span aria-hidden="true"> →</span></a></p>}
        </div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" id={a.equipment} labelledby="equipment-title">
    <Container>
      <TwoCol id="equipment-title" eyebrow={copy.equipment.eyebrow} title={copy.equipment.h2}>
        <div class="stack">{copy.equipment.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="month-title">
    <Container>
      <SectionHead id="month-title" eyebrow={copy.month.eyebrow} title={copy.month.h2} />
      <div class="month">
        <div class="stack">
          <p>{copy.month.p1}</p>
          <p>{copy.month.p2}</p>
          <p>{copy.month.p3}</p>
        </div>
        <Placeholder name="[[CAPTURA_RAPORT_LUNAR]]" caption={copy.month.figureCaption} ratio="3 / 4" class="month__figure" />
      </div>
    </Container>
  </Section>

  <Section tone="surface-2" labelledby="fit-title">
    <Container>
      <SectionHead id="fit-title" eyebrow={copy.fit.eyebrow} title={copy.fit.h2} />
      <div class="lists">
        <div class="lists__col">
          <h3 class="lists__title">{copy.fit.yesTitle}</h3>
          <ul class="marks">{copy.fit.yes.map((it) => <li>{it}</li>)}</ul>
        </div>
        <div class="lists__col">
          <h3 class="lists__title">{copy.fit.noTitle}</h3>
          <ul class="marks marks--muted">{copy.fit.no.map((it) => <li>{it}</li>)}</ul>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="bg" id={a.faq} labelledby="faq-title">
    <Container>
      <TwoCol id="faq-title" eyebrow={copy.faq.h2} title={copy.faq.h2}>
        <Faq items={copy.faq.items} lang={lang} />
      </TwoCol>
    </Container>
  </Section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--s-4); }
  .stack a { font-family: var(--font-display); font-weight: 600; }
  .lists { display: grid; gap: var(--s-6); }
  @media (min-width: 768px) { .lists { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s-8); } }
  .lists__col { display: grid; gap: var(--s-4); align-content: start; }
  .lists__title { font-size: var(--fs-h3); }
  .marks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .marks li { position: relative; padding-left: var(--s-5); }
  .marks li::before { content: ''; position: absolute; left: 0; top: .6em; width: var(--s-3); height: 3px; background: var(--teal); }
  .marks--muted li::before { background: var(--muted); }
  .row-note { margin-top: var(--s-6); max-width: 70ch; padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .grid-3 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .month { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 1024px) { .month { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--s-8); } }
  .month .stack { max-width: 70ch; }
</style>
