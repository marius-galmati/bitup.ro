---
/**
 * /servicii/securitate, /en/services/security (04).
 * Ritm: hero cu buton → Situația (două coloane) → Șase carduri (3×2, pe surface; singurul grid din pagină) → Backup (două coloane, cu exemplu)
 * → Audit (două coloane, surface) → NIS2 (două coloane) → Incidente: patru pași în rând pe surface-2 + rândul cu telefonul → FAQ (două coloane) → CtaBand.
 * JSON-LD: Service + FAQPage.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import TwoCol from '../TwoCol.astro';
import Card from '../Card.astro';
import Steps from '../Steps.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { localePath, dynamicPath, anchors, absoluteUrl, routes, type Locale } from '../../i18n';
import { service } from '../../lib/schema';
import { site } from '../../lib/site';
import { isProduction } from '../../lib/env';
import type { SecurityCopy } from '../../copy/security.ro';

interface Props { lang: Locale; copy: SecurityCopy }
const { lang, copy } = Astro.props;
const a = anchors.security[lang];
const cosmio = (await getCollection('cases', (e) => e.id === `${lang}/cosmio`))[0];
// Regula (Faza 2b, decizia lui Marius): când studiul de caz e draft sau lipsește, propoziția care îl linkuiește nu se randează deloc, pe nicio pagină.
const showCosmio = !!cosmio && (!cosmio.data.draft || !isProduction);
const jsonLd = [service(lang, copy.serviceName, copy.description, absoluteUrl(routes.security[lang]))];
---
<BaseLayout lang={lang} routeKey="security" title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead} button={{ label: copy.hero.button, href: localePath('healthCheck', lang), event: 'cta_radiografie_click' }} />

  <Section tone="bg" labelledby="situation-title">
    <Container>
      <TwoCol id="situation-title" eyebrow={copy.situation.eyebrow} title={copy.situation.h2}>
        <div class="stack">{copy.situation.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" labelledby="protect-title">
    <Container>
      <SectionHead id="protect-title" eyebrow={copy.protect.eyebrow} title={copy.protect.h2} />
      <div class="grid-6">
        {copy.protect.cards.map((c) => (
          c.anchor
            ? <Card title={c.title} href={`#${a.backup}`} linkLabel={copy.backup.h2}><p>{c.text}</p></Card>
            : <Card title={c.title}><p>{c.text}</p></Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="bg" id={a.backup} labelledby="backup-title">
    <Container>
      <TwoCol id="backup-title" eyebrow={copy.backup.eyebrow} title={copy.backup.h2}>
        <div class="stack">
          {copy.backup.paragraphs.map((p) => <p>{p}</p>)}
          {showCosmio && <p>{copy.backup.example} <a href={dynamicPath('caseStudy', lang, 'cosmio')}>{copy.backup.caseLink}<span aria-hidden="true"> →</span></a></p>}
        </div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface" id={a.audit} labelledby="audit-title">
    <Container>
      <TwoCol id="audit-title" eyebrow={copy.audit.eyebrow} title={copy.audit.h2}>
        <div class="stack">{copy.audit.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" id={a.nis2} labelledby="nis2-title">
    <Container>
      <TwoCol id="nis2-title" eyebrow={copy.nis2.eyebrow} title={copy.nis2.h2}>
        <div class="stack">{copy.nis2.paragraphs.map((p) => <p>{p}</p>)}</div>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="surface-2" id={a.incidents} labelledby="incidents-title">
    <Container>
      <SectionHead id="incidents-title" eyebrow={copy.incidents.eyebrow} title={copy.incidents.h2} />
      <Steps steps={copy.incidents.steps} />
      <p class="row-note">{copy.incidents.row} <a class="mono" href={site.phone.href} data-event="tel_click">{site.phone.display}</a></p>
    </Container>
  </Section>

  <Section tone="bg" id={a.faq} labelledby="faq-title">
    <Container>
      <TwoCol id="faq-title" eyebrow={copy.faq.h2} title={copy.faq.h2}>
        <Faq items={copy.faq.items} lang={lang} />
      </TwoCol>
    </Container>
  </Section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--s-4); }
  .stack a { font-family: var(--font-display); font-weight: 600; }
  .grid-6 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  @media (min-width: 1024px) { .grid-6 { grid-template-columns: repeat(3, 1fr); } }
  .row-note { margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--line); max-width: 70ch; }
  .row-note a { font-weight: 500; white-space: nowrap; }
</style>
