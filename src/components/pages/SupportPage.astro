---
/**
 * /suport, /en/support (10). Pentru clienți existenți; fără CtaBand de vânzare. Singurul buton plin teal din site (WhatsApp); niciun buton orange în pagină.
 * Ritm: hero cu două butoane → trei carduri (bg) → tabel de priorități (surface) → patru pași (bg) → sfaturi, listă (două coloane, surface-2)
 * → Ce nu face Cipri (două coloane, bg) → rândul pentru cine nu e client. JSON-LD: global.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroInternal from '../HeroInternal.astro';
import Container from '../Container.astro';
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import TwoCol from '../TwoCol.astro';
import Button from '../Button.astro';
import Card from '../Card.astro';
import { localePath, type Locale } from '../../i18n';
import { site } from '../../lib/site';
import type { SupportCopy } from '../../copy/support.ro';

interface Props { lang: Locale; copy: SupportCopy }
const { lang, copy } = Astro.props;
const [wa, hd, tel] = copy.ways.cards;
---
<BaseLayout lang={lang} routeKey="support" title={copy.title} description={copy.description}>
  <HeroInternal eyebrow={copy.hero.eyebrow} h1={copy.hero.h1} lead={copy.hero.lead}>
    <div class="sup-actions">
      <Button href={site.whatsapp.href} variant="teal" external data-event="whatsapp_click">{copy.hero.whatsapp}</Button>
      <Button href={site.helpdesk} variant="secondary" external>{copy.hero.helpdesk}</Button>
    </div>
  </HeroInternal>

  <Section tone="bg" labelledby="ways-title">
    <Container>
      <SectionHead id="ways-title" eyebrow={copy.ways.eyebrow} title={copy.ways.h2} />
      <div class="grid-3">
        <Card title={wa.title}>
          <p>{wa.text}</p>
          <p class="card-line"><span class="muted">{wa.numberLabel}</span> <a class="tnum" href={site.whatsapp.href} target="_blank" rel="noopener" data-event="whatsapp_click">{site.whatsapp.display}</a></p>
        </Card>
        <Card title={hd.title}>
          <p>{hd.text}</p>
          <p class="card-line"><a href={site.helpdesk} target="_blank" rel="noopener">{hd.linkLabel}<span aria-hidden="true"> →</span></a></p>
        </Card>
        <Card title={tel.title}>
          <p>{tel.text}</p>
          <p class="card-line"><span class="muted">{tel.numberLabel}</span> <a class="tnum" href={site.phone.href} data-event="tel_click">{site.phone.display}</a></p>
          <p class="card-line small muted">{tel.hours}</p>
        </Card>
      </div>
    </Container>
  </Section>

  <Section tone="surface" labelledby="priorities-title">
    <Container>
      <SectionHead id="priorities-title" eyebrow={copy.priorities.eyebrow} title={copy.priorities.h2} />
      <div class="table-wrap">
        <table class="prio">
          <thead><tr>{copy.priorities.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {copy.priorities.rows.map((r) => (
              <tr>
                <th scope="row" class="prio__level">{r.level}</th>
                <td data-label={copy.priorities.head[1]}>{r.examples}</td>
                <td data-label={copy.priorities.head[2]}>{r.action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted prio__note">{copy.priorities.row}</p>
    </Container>
  </Section>

  <Section tone="bg" labelledby="after-title">
    <Container>
      <h2 id="after-title" class="after-h2">{copy.after.h2}</h2>
      <ol class="after-steps">
        {copy.after.steps.map((s, i) => <li class="after-step"><span class="after-step__num" aria-hidden="true">{i + 1}</span><p>{s}</p></li>)}
      </ol>
    </Container>
  </Section>

  <Section tone="surface-2" labelledby="tips-title">
    <Container>
      <TwoCol id="tips-title" eyebrow={copy.tips.eyebrow} title={copy.tips.h2}>
        <ul class="marks">{copy.tips.items.map((it) => <li><strong class="marks__title">{it.title}</strong> <span>{it.text}</span></li>)}</ul>
      </TwoCol>
    </Container>
  </Section>

  <Section tone="bg" labelledby="not-title">
    <Container>
      <TwoCol id="not-title" eyebrow={copy.not.eyebrow} title={copy.not.h2}><p>{copy.not.text}</p></TwoCol>
    </Container>
  </Section>

  <Section tone="surface" line labelledby="notclient-title">
    <Container>
      <h2 id="notclient-title" class="sr-only">{copy.notClient.h2}</h2>
      <p class="muted notclient">{copy.notClient.before}<a href={localePath('healthCheck', lang)}>{copy.notClient.link}</a>{copy.notClient.after}</p>
    </Container>
  </Section>
</BaseLayout>

<style>
  .sup-actions { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4); margin-top: var(--s-2); }
  .grid-3 { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .card-line { margin-top: var(--s-2); }
  .card-line a { font-weight: 600; }
  .table-wrap { overflow-x: auto; }
  .prio { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .prio th, .prio td { text-align: left; vertical-align: top; padding: var(--s-3) var(--s-3); border-top: 1px solid var(--line); }
  .prio thead th { border-top: 0; font-size: var(--fs-label); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--teal); }
  .prio tbody tr:last-child th, .prio tbody tr:last-child td { border-bottom: 1px solid var(--line); }
  .prio__level { font-family: var(--font-display); font-weight: 600; color: var(--navy); white-space: nowrap; }
  .prio__note { margin-top: var(--s-4); }
  /* sub 768: tabelul devine rânduri stivuite (nivelul ca titlu, etichetele coloanelor din data-label), fără derulare orizontală */
  @media (max-width: 767px) {
    .prio { min-width: 0; }
    .prio thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
    .prio, .prio tbody, .prio tr, .prio th, .prio td { display: block; }
    .prio tr { padding-block: var(--s-3); border-top: 1px solid var(--line); }
    .prio tbody tr:last-child { border-bottom: 1px solid var(--line); }
    .prio th, .prio td { border: 0; padding: var(--s-1) 0; }
    .prio tbody tr:last-child th, .prio tbody tr:last-child td { border-bottom: 0; }
    .prio td::before { content: attr(data-label); display: block; font-size: var(--fs-label); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--teal); margin-bottom: 2px; }
  }
  .after-h2 { margin-bottom: var(--s-6); max-width: 26ch; }
  .after-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .after-step { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; }
  .after-step__num { width: var(--s-6); height: var(--s-6); display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--teal); color: #FFFFFF; font-family: var(--font-display); font-weight: 700; font-size: 20px; }
  :root[data-theme="dark"] .after-step__num { color: #00202E; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .after-step__num { color: #00202E; } }
  .marks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .marks li { position: relative; padding-left: var(--s-5); }
  .marks li::before { content: ''; position: absolute; left: 0; top: .6em; width: var(--s-3); height: 3px; background: var(--teal); }
  .marks__title { font-family: var(--font-display); font-weight: 600; color: var(--navy); }
  .notclient { max-width: 70ch; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
