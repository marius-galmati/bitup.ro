---
/** Eyebrow (DESIGN § Tipografie, 26 sept. 2026): Barlow Condensed 300, majuscule, --navy (--on-navy pe fundal navy),
    fără letter-spacing adăugat. Stă direct deasupra titlului. E tipografie, nu pilulă: fără fundal, fără bordură. */
interface Props { onNavy?: boolean; as?: 'p' | 'span' | 'div'; class?: string }
const { onNavy = false, as: Tag = 'p', class: className } = Astro.props as Props;
---
<Tag class:list={['eyebrow', { 'eyebrow--navy': onNavy }, className]}><slot /></Tag>

<style>
  .eyebrow { font-family: var(--font-display); font-size: var(--fs-eyebrow); font-weight: 300; line-height: 1.1; text-transform: uppercase; color: var(--navy); margin: 0; }
  .eyebrow--navy { color: var(--teal-2); }
</style>
