---
/**
 * Diagrama fluxului Radiografie → Plan → Preluare → Lună de lună (DESIGN § Imagini și grafică: SVG inline, linii 1.5 px, culori din tokeni).
 * SVG-ul e decorativ (aria-hidden); textul nodurilor e HTML, sub el, ca să fie citit și copiat. Pe mobil, coloană verticală cu linie continuă.
 */
interface Props { nodes: { title: string; meta: string; text: string }[] }
const { nodes } = Astro.props;
---
<div class="pd">
  <svg class="pd__svg pd__svg--h" viewBox="0 0 1000 96" aria-hidden="true" focusable="false">
    <defs><marker id="pd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="var(--teal)" /></marker></defs>
    {[0, 1, 2, 3].map((i) => (
      <g>
        <rect x={12 + i * 250} y="28" width="200" height="40" rx="4" fill="var(--surface)" stroke="var(--teal)" stroke-width="1.5" />
        <text x={112 + i * 250} y="53" text-anchor="middle" font-family="var(--font-mono)" font-size="14" fill="var(--teal)">{`0${i + 1}`}</text>
      </g>
    ))}
    {[0, 1, 2].map((i) => <line x1={214 + i * 250} y1="48" x2={258 + i * 250} y2="48" stroke="var(--teal)" stroke-width="1.5" marker-end="url(#pd-arrow)" />)}
    {/* bucla pasului 4 */}
    <path d="M 962 48 C 990 48 990 8 962 8 L 812 8" fill="none" stroke="var(--teal)" stroke-width="1.5" stroke-dasharray="4 4" />
    <path d="M 812 8 C 780 8 780 28 800 28" fill="none" stroke="var(--teal)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#pd-arrow)" />
  </svg>
  <ol class="pd__list">
    {nodes.map((n, i) => (
      <li class="pd__node">
        <span class="pd__num mono" aria-hidden="true">0{i + 1}</span>
        <h3 class="pd__title">{n.title}</h3>
        <p class="pd__meta mono">{n.meta}</p>
        <p class="pd__text">{n.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .pd { display: grid; gap: var(--s-4); }
  .pd__svg--h { display: none; width: 100%; height: auto; }
  .pd__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .pd__node { display: grid; gap: var(--s-1); padding-left: var(--s-6); position: relative; }
  .pd__num { position: absolute; left: 0; top: 2px; color: var(--teal); font-size: var(--fs-small); font-weight: 500; }
  .pd__node::before { content: ''; position: absolute; left: 9px; top: 26px; bottom: calc(var(--s-5) * -1); border-left: 1.5px dashed var(--teal); }
  .pd__node:last-child::before { display: none; }
  .pd__title { font-size: var(--fs-h3); }
  .pd__meta { font-size: var(--fs-eyebrow); color: var(--muted); letter-spacing: .04em; }
  .pd__text { font-size: var(--fs-small); color: var(--text); }
  @media (min-width: 1024px) {
    .pd__svg--h { display: block; }
    .pd__list { grid-template-columns: repeat(4, 1fr); gap: var(--s-6); }
    .pd__node { padding-left: 0; padding-inline: 12px; }
    .pd__num { display: none; }
    .pd__node::before { display: none; }
  }
</style>
