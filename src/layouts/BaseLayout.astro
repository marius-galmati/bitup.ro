---
/**
 * BaseLayout (docs/spec-tehnica.md § 4, § 5, § 8).
 * <html lang>, title/description, canonical, hreflang (ro, en, x-default), Open Graph, JSON-LD Organization + ProfessionalService,
 * scriptul de temă (înainte de randare, fără pâlpâire), preîncărcarea fonturilor 400 și 600, skip-link și <main>.
 * Antetul și subsolul intră în faza 2, prin sloturile `header` și `footer`.
 */
import '../styles/global.css';
import plexRegular from '../../brand/fonts/IBMPlexSans-Regular.woff2?url';
import plexSemiBold from '../../brand/fonts/IBMPlexSans-SemiBold.woff2?url';
import tokens from '../../brand/brand-tokens.json';

import { t, routes, absoluteUrl, type Locale, type RouteKey } from '../i18n';
import { baseGraph } from '../lib/schema';
import { site } from '../lib/site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Cheia rutei statice: dă canonical, hreflang și pagina pereche. */
  routeKey?: RouteKey;
  /** Pentru rute dinamice: calea curentă și calea pereche. */
  path?: string;
  altPath?: string;
  noindex?: boolean;
  /** Fără hreflang (pagina nu are pereche reală, de exemplu 404 sau /styleguide). */
  noAlternates?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  rss?: string;
}
const { lang, title, description, routeKey, path, altPath, noindex = false, noAlternates = false, jsonLd = [], ogType = 'website', rss } = Astro.props;

const dict = t(lang);
const other: Locale = lang === 'ro' ? 'en' : 'ro';
const currentPath = path ?? (routeKey ? routes[routeKey][lang] : Astro.url.pathname);
const pairPath = altPath ?? (routeKey ? routes[routeKey][other] : routes.home[other]);
const canonical = absoluteUrl(currentPath);
const altAbsolute = absoluteUrl(pairPath);
const roUrl = lang === 'ro' ? canonical : altAbsolute;
const enUrl = lang === 'en' ? canonical : altAbsolute;
const graph = baseGraph(lang, jsonLd);
// Culoarea barei browserului: din brand-tokens.json (alb pe deschis, bleumarin pe închis), nu scrisă de mână.
const themeLight = tokens.colors.neutral_white.hex;
const themeDark = tokens.colors.primary.hex;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noAlternates && (
      <>
        <link rel="alternate" hreflang="ro" href={roUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={roUrl} />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_US' : 'ro_RO'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {rss && <link rel="alternate" type="application/rss+xml" title={site.name} href={absoluteUrl(rss)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeDark} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('bitup-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={plexRegular} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={plexSemiBold} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#continut">{dict.skipLink}</a>
    <slot name="header" />
    <main id="continut" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
