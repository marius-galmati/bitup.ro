---
/**
 * BaseLayout (PLAN Faza 1, ARHITECTURA § Limbi, § SEO, § Dark mode).
 * Primește limba și cheia rutei; setează <html lang>, title/description, canonical, hreflang (ro, en, x-default), Open Graph,
 * JSON-LD Organization + ProfessionalService (plus ce dă pagina), scriptul de temă, skip-link, header, <main>, footer, ConsentBanner.
 */
import '@fontsource-variable/public-sans/wght.css';
// Barlow Condensed, doar cele două greutăți și cele două subseturi din DESIGN § Tipografie.
// Fișierele se aleg prin `unicode-range`, deci paginile EN nu descarcă latin-ext decât dacă întâlnesc diacritice.
import '@fontsource/barlow-condensed/latin-300.css';
import '@fontsource/barlow-condensed/latin-ext-300.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-ext-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import fontLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import fontLatinExt from '@fontsource-variable/public-sans/files/public-sans-latin-ext-wght-normal.woff2?url';
import displayLatin from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import displayLatinExt from '@fontsource/barlow-condensed/files/barlow-condensed-latin-ext-700-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { t, routes, absoluteUrl, type Locale, type RouteKey } from '../i18n';
import { baseGraph } from '../lib/schema';
import { site } from '../lib/site';

interface Props {
  lang: Locale;
  title: string;            // exact din fișierul de conținut (include „· BitUp” unde e cazul)
  description: string;
  /** Cheia rutei statice: dă canonical, hreflang și pagina pereche. */
  routeKey?: RouteKey;
  /** Pentru rute dinamice: calea curentă și calea pereche (sau indexul secțiunii din cealaltă limbă). */
  path?: string;
  altPath?: string;
  noindex?: boolean;
  /** Fără hreflang (pagina nu are pereche reală, de ex. 404). */
  noAlternates?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Calea fluxului RSS al limbii (pe paginile de blog): <link rel="alternate" type="application/rss+xml">. */
  rss?: string;
}
const { lang, title, description, routeKey, path, altPath, noindex = false, noAlternates = false, jsonLd = [], ogType = 'website', rss } = Astro.props;

const dict = t(lang);
const other: Locale = lang === 'ro' ? 'en' : 'ro';
const currentPath = path ?? (routeKey ? routes[routeKey][lang] : Astro.url.pathname);
const pairPath = altPath ?? (routeKey ? routes[routeKey][other] : routes.home[other]);
const canonical = absoluteUrl(currentPath);
const altAbsolute = absoluteUrl(pairPath);
const roUrl = lang === 'ro' ? canonical : altAbsolute;
const enUrl = lang === 'en' ? canonical : altAbsolute;
const graph = baseGraph(lang, jsonLd);
// Preîncărcăm doar fonturile de deasupra pliului: textul și titlul (Barlow 700, elementul LCP).
// `latin-ext` doar pe RO: pe EN ar fi 32 KB descărcați degeaba, iar diacriticele izolate
// (numele din /en/team) se încarcă la nevoie, fără să întârzie LCP-ul.
const fonturi = lang === 'ro' ? [fontLatin, fontLatinExt, displayLatin, displayLatinExt] : [fontLatin, displayLatin];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noAlternates && (
      <>
        <link rel="alternate" hreflang="ro" href={roUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={roUrl} />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_US' : 'ro_RO'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {rss && <link rel="alternate" type="application/rss+xml" title={site.name} href={absoluteUrl(rss)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F5F8F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C181D" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('bitup-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    {fonturi.map((href) => <link rel="preload" as="font" type="font/woff2" crossorigin href={href} />)}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#continut">{dict.skipLink}</a>
    <Header lang={lang} altHref={pairPath} currentKey={routeKey ?? null} />
    <main id="continut" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} altHref={pairPath} />
    <ConsentBanner lang={lang} />
  </body>
</html>

<style is:global>
  .skip-link { position: absolute; left: var(--s-4); top: -100px; z-index: 100; padding: var(--s-2) var(--s-4); background: var(--navy-surface); color: var(--on-navy); font-family: var(--font-display); font-weight: 600; border-radius: var(--r-pill); text-decoration: none; }
  .skip-link:focus { top: var(--s-4); outline: 2px solid var(--teal); outline-offset: 2px; }
  main:focus { outline: none; }
</style>
