---
/**
 * PostLayout (DESIGN § Articol): antet pe --bg (eyebrow „Blog · categorie”, h1, lead = description, byline nume · dată · timp de citit, fără avatar),
 * corpul în Prose 70ch (imaginile din Markdown devin figuri cu legendă din alt, bordură, lazy), caseta de autor, CtaBand varianta blog.
 * JSON-LD: Article. Comutatorul de limbă: perechea din `translationOf` sau indexul blogului din cealaltă limbă.
 */
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Prose from '../components/Prose.astro';
import AuthorBox from '../components/AuthorBox.astro';
import CtaBand from '../components/CtaBand.astro';
import type { CollectionEntry } from 'astro:content';
import { absoluteUrl, dynamicPath, formatDate, localePath, routes, t, type Locale } from '../i18n';
import { article } from '../lib/schema';
import { postMeta, readMinutes, slugOf } from '../lib/collections';

interface Props { lang: Locale; entry: CollectionEntry<'blog'> }
const { lang, entry } = Astro.props;
const dict = t(lang);
const d = entry.data;
const other: Locale = lang === 'ro' ? 'en' : 'ro';
const path = dynamicPath('post', lang, slugOf(entry.id));
const altPath = d.translationOf ? dynamicPath('post', other, d.translationOf) : routes.blog[other];
const meta = postMeta(entry);
const minutes = readMinutes(entry.body);

// imaginile din Markdown: <p><img …></p> → figură cu legendă (alt-ul), în stilul Figure (captură de ecran)
const html = (await Astro.slots.render('default')).replace(/<a href="http/g, '<a target="_blank" rel="noopener" href="http').replace(
  /<p>\s*(<img\b[^>]*\balt="([^"]*)"[^>]*>)\s*<\/p>/g,
  (_m, img: string, alt: string) => `<figure class="figure figure--screenshot"><div class="figure__media">${img}</div><figcaption class="figure__caption">${alt}</figcaption></figure>`,
);
const jsonLd = [article(lang, {
  headline: d.title, description: d.description, url: absoluteUrl(path), datePublished: d.pubDate, dateModified: d.updatedDate,
  ...(d.heroImage ? { imageUrl: absoluteUrl(d.heroImage.src) } : {}),
})];
---
<BaseLayout lang={lang} path={path} altPath={altPath} title={meta.title} description={meta.description} jsonLd={jsonLd} ogType="article" rss={localePath('rss', lang)} noindex={d.draft}>
  <Section tone="bg" class="post-head">
    <Container narrow>
      <Eyebrow>{dict.misc.blogEyebrow}{d.tags[0] && <span> · {d.tags[0]}</span>}{d.draft && <span> · {dict.misc.draft}</span>}</Eyebrow>
      <h1 class="post-head__h1">{d.title}</h1>
      <p class="lead post-head__lead">{d.description}</p>
      <p class="small muted post-head__byline tnum">{d.author} · <time datetime={d.pubDate.toISOString().slice(0, 10)}>{formatDate(d.pubDate, lang)}</time> · {dict.misc.readTime(minutes)}</p>
    </Container>
  </Section>

  <Section tone="surface" line>
    <Container narrow>
      <Prose lang={lang}><Fragment set:html={html} /></Prose>
      <AuthorBox lang={lang} />
    </Container>
  </Section>

  <CtaBand lang={lang} variant="blog" />
</BaseLayout>

<style is:global>
  .post-head__h1 { margin-top: var(--s-3); max-width: 22ch; }
  .post-head__lead { margin-top: var(--s-4); max-width: 60ch; }
  .post-head__byline { margin-top: var(--s-5); }
  .prose .figure { margin: var(--s-6) 0; display: grid; gap: var(--s-2); }
  .prose .figure__media { padding: 10px; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-media); }
  .prose .figure__media img { display: block; width: 100%; height: auto; border-radius: var(--r-media); }
  :root[data-theme="dark"] .prose .figure--screenshot img { filter: brightness(.92); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .prose .figure--screenshot img { filter: brightness(.92); } }
  .prose .figure__caption { font-size: var(--fs-small); color: var(--muted); }
  .prose + .author { margin-top: var(--s-8); }
</style>
